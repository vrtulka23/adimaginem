# Cited concepts, classified for the human model.
ontology
  concepts map : ontological_concept
  concepts[human_person]
    label = "Human person"
    domain = "anthropology"
    category = "person"
    note = "The embodied human being, not the soul alone."
    source_id = "st_i_75_4"
  concepts[human_body]
    label = "Human body"
    domain = "anthropology"
