# Cited concepts, classified for the human model.
ontology
  concepts map : ontological_concept
  concepts[human_person]
    latin_name = "persona humana"
    label = "Human person"
    domain = "anthropology"
    category = "person"
    note = "The embodied human being, not the soul alone."
    source_id = "st_i_75_4"

  concepts[human_body]
    latin_name = "corpus humanum"
    label = "Human body"
    domain = "anthropology"
    category = "body"
    note = "The corporeal dimension of the human person."
    source_id = "st_i_75_4"

  concepts[rational_soul]
    latin_name = "anima rationalis"
    label = "Rational soul"
    domain = "anthropology"
    category = "substantial_form"
    note = "The substantial form of the living human being."
    source_id = "st_i_76_1"

  concepts[soul_power]
    latin_name = "potentia animae"
    label = "Power of the soul"
    domain = "anthropology"
    category = "power"
    note = "A principle of operation distinct from the soul's essence."
    source_id = "st_i_77_1"

  concepts[vegetative_power]
    latin_name = "potentia vegetativa"
    label = "Vegetative power genus"
    domain = "anthropology"
    category = "power_genus"
    note = "One of the five genera of powers in ST I, q. 78, a. 1."
    source_id = "st_i_78_1"

  concepts[sensitive_power]
    latin_name = "potentia sensitiva"
    label = "Sensitive power genus"
    domain = "anthropology"
    category = "power_genus"
    note = "One of the five genera of powers in ST I, q. 78, a. 1."
    source_id = "st_i_78_1"

  concepts[appetitive_power]
    latin_name = "potentia appetitiva"
    label = "Appetitive power genus"
    domain = "anthropology"
    category = "power_genus"
    note = "One of the five genera of powers in ST I, q. 78, a. 1."
    source_id = "st_i_78_1"

  concepts[locomotive_power]
    latin_name = "potentia motiva secundum locum"
    label = "Locomotive power genus"
    domain = "anthropology"
    category = "power_genus"
    note = "One of the five genera of powers in ST I, q. 78, a. 1."
    source_id = "st_i_78_1"

  concepts[intellectual_power]
    latin_name = "potentia intellectiva"
    label = "Intellectual power genus"
    domain = "anthropology"
    category = "power_genus"
    note = "One of the five genera of powers in ST I, q. 78, a. 1."
    source_id = "st_i_78_1"

  concepts[bodily_organ]
    latin_name = "organum corporale"
    label = "Bodily organ"
    domain = "anthropology"
    category = "organ"
    note = "A bodily instrument for operations of sensitive powers; no specific anatomy is asserted here."
    source_id = "st_i_78_1"

  concepts[nutritive_power]
    latin_name = "potentia nutritiva"
    label = "Nutritive power"
    domain = "anthropology"
    category = "power"
    note = "Preserves the living body through nourishment."
    source_id = "st_i_78_2"

  concepts[augmentative_power]
    latin_name = "potentia augmentativa"
    label = "Augmentative power"
    domain = "anthropology"
    category = "power"
    note = "Orders the living body toward its due growth."
    source_id = "st_i_78_2"

  concepts[generative_power]
    latin_name = "potentia generativa"
    label = "Generative power"
    domain = "anthropology"
    category = "power"
    note = "Orders generation of another living thing of the same kind."
    source_id = "st_i_78_2"

  concepts[external_sense]
    latin_name = "sensus exterior"
    label = "Exterior sense"
    domain = "anthropology"
    category = "power_genus"
    note = "The group of five exterior sensitive powers, distinguished by their proper sensible objects."
    source_id = "st_i_78_3"

  concepts[sight]
    latin_name = "visus"
    label = "Sight"
    domain = "anthropology"
    category = "power"
    note = "Exterior sense for visible qualities."
    source_id = "st_i_78_3"

  concepts[hearing]
    latin_name = "auditus"
    label = "Hearing"
    domain = "anthropology"
    category = "power"
    note = "Exterior sense for sound."
    source_id = "st_i_78_3"

  concepts[smell]
    latin_name = "olfactus"
    label = "Smell"
    domain = "anthropology"
    category = "power"
    note = "Exterior sense for odor."
    source_id = "st_i_78_3"

  concepts[taste]
    latin_name = "gustus"
    label = "Taste"
    domain = "anthropology"
    category = "power"
    note = "Exterior sense for flavor."
    source_id = "st_i_78_3"

  concepts[touch]
    latin_name = "tactus"
    label = "Touch"
    domain = "anthropology"
    category = "power"
    note = "Exterior sense for tangible qualities; Aquinas discusses its possible further division."
    source_id = "st_i_78_3"

  concepts[internal_sense]
    latin_name = "sensus interior"
    label = "Interior sense"
    domain = "anthropology"
    category = "power_genus"
    note = "Interior sensitive powers considered in ST I, q. 78, a. 4."
    source_id = "st_i_78_4"

  concepts[common_sense]
    latin_name = "sensus communis"
    label = "Common sense"
    domain = "anthropology"
    category = "power"
    note = "Interior sense that discerns among exterior sensations and perceives their acts."
    source_id = "st_i_78_4"

  concepts[imagination]
    latin_name = "imaginatio"
    label = "Imagination"
    domain = "anthropology"
    category = "power"
    note = "Interior power retaining sensible forms in the absence of the sensed thing."
    source_id = "st_i_78_4"

  concepts[cogitative_power]
    latin_name = "vis cogitativa"
    label = "Cogitative power"
    domain = "anthropology"
    category = "power"
    note = "The human interior sense that compares particular intentions; called particular reason."
    source_id = "st_i_78_4"

  concepts[sensitive_memory]
    latin_name = "vis memorativa"
    label = "Sensitive memory"
    domain = "anthropology"
    category = "power"
    note = "Interior sense retaining intentions apprehended in the past."
    source_id = "st_i_78_4"

  concepts[possible_intellect]
    latin_name = "intellectus possibilis"
    label = "Possible intellect"
    domain = "anthropology"
    category = "power"
    note = "Intellect receptive of intelligible forms; not a bodily organ."
    source_id = "st_i_79_2"

  concepts[agent_intellect]
    latin_name = "intellectus agens"
    label = "Agent intellect"
    domain = "anthropology"
    category = "power"
    note = "Active intellectual power rendering phantasms intelligible in act."
    source_id = "st_i_79_3"

  concepts[sensitive_appetite]
    latin_name = "appetitus sensitivus"
    label = "Sensitive appetite"
    domain = "anthropology"
    category = "power"
    note = "Appetite following sensitive apprehension; distinct from intellectual appetite."
    source_id = "st_i_80_2"

  concepts[will]
    latin_name = "voluntas"
    label = "Will"
    domain = "anthropology"
    category = "power"
    note = "Intellectual appetite, ordered to the good as understood."
    source_id = "st_i_80_2"

  concepts[concupiscible_appetite]
    latin_name = "vis concupiscibilis"
    label = "Concupiscible appetite"
    domain = "anthropology"
    category = "power"
    note = "Sensitive appetitive power concerning suitable or harmful things considered simply."
    source_id = "st_i_81_2"

  concepts[irascible_appetite]
    latin_name = "vis irascibilis"
    label = "Irascible appetite"
    domain = "anthropology"
    category = "power"
    note = "Sensitive appetitive power concerning arduous good or evil and obstacles."
    source_id = "st_i_81_2"

  concepts[choice]
    latin_name = "electio"
    label = "Choice"
    domain = "anthropology"
    category = "act"
    note = "Act of willing concerned with means; free choice and will are one power, not two."
    source_id = "st_i_83_4"

  concepts[matter]
    latin_name = "materia"
    label = "Matter"
    domain = "metaphysics"
    category = "principle"
    note = "A principle of natural generation, understood with respect to form."
    source_id = "dpn_8"

  concepts[form]
    latin_name = "forma"
    label = "Form"
    domain = "metaphysics"
    category = "principle"
    note = "That through which the generated thing comes to be in act."
    source_id = "dpn_8"

  concepts[potentiality]
    latin_name = "potentia"
    label = "Potentiality"
    domain = "metaphysics"
    category = "principle"
    note = "A mode of being prior to actuality in a process of generation."
    source_id = "dpn_8"

  concepts[actuality]
    latin_name = "actus"
    label = "Actuality"
    domain = "metaphysics"
    category = "principle"
    note = "The mode of being attained through form in the cited account."
    source_id = "dpn_8"

  concepts[privation]
    latin_name = "privatio"
    label = "Privation"
    domain = "metaphysics"
    category = "principle"
    note = "A principle of becoming, distinguished from matter and form."
    source_id = "dpn_12"

  concepts[natural_generation]
    latin_name = "generatio naturalis"
    label = "Natural generation"
    domain = "metaphysics"
    category = "process"
    note = "The coming to be of a natural composite."
    source_id = "dpn_8"

  concepts[substance]
    latin_name = "substantia"
    label = "Substance"
    domain = "metaphysics"
    category = "principle"
    note = "That which has substantial existence in the cited distinction."
    source_id = "dpn_1"

  concepts[accident]
    latin_name = "accidens"
    label = "Accident"
    domain = "metaphysics"
    category = "principle"
    note = "A determination that exists in a subject."
    source_id = "dpn_3"

  concepts[cause]
    latin_name = "causa"
    label = "Cause"
    domain = "metaphysics"
    category = "principle"
    note = "General category of the four per se causes distinguished here."
    source_id = "dpn_20"

  concepts[material_cause]
    latin_name = "causa materialis"
    label = "Material cause"
    domain = "metaphysics"
    category = "principle"
    note = "One of the four per se causes."
    source_id = "dpn_20"

  concepts[formal_cause]
    latin_name = "causa formalis"
    label = "Formal cause"
    domain = "metaphysics"
    category = "principle"
    note = "One of the four per se causes."
    source_id = "dpn_20"

  concepts[efficient_cause]
    latin_name = "causa efficiens"
    label = "Efficient cause"
    domain = "metaphysics"
    category = "principle"
    note = "One of the four per se causes."
    source_id = "dpn_20"

  concepts[final_cause]
    latin_name = "causa finalis"
    label = "Final cause"
    domain = "metaphysics"
    category = "principle"
    note = "One of the four per se causes."
    source_id = "dpn_20"
