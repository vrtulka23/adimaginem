  concepts[matter]
    label = "Matter"
    domain = "metaphysics"
    category = "principle"
    note = "A principle of natural generation, understood with respect to form."
    source_id = "dpn_8"
  concepts[form]
    label = "Form"
    domain = "metaphysics"
    category = "principle"
    note = "That through which the generated thing comes to be in act."
    source_id = "dpn_8"
  concepts[potentiality]
    label = "Potentiality"
    domain = "metaphysics"
    category = "principle"
    note = "A mode of being prior to actuality in a process of generation."
    source_id = "dpn_8"
  concepts[actuality]
    label = "Actuality"
    domain = "metaphysics"
    category = "principle"
    note = "The mode of being attained through form in the cited account."
    source_id = "dpn_8"
  concepts[privation]
    label = "Privation"
    domain = "metaphysics"
    category = "principle"
    note = "A principle of becoming, distinguished from matter and form."
