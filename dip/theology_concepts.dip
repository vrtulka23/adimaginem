    latin_name = "Eucharistia"
    label = "Eucharist"
    domain = "theology"
    category = "sacrament"
    note = "One of the seven sacraments of the New Law; specific signs and effects require separate cited records."
    source_id = "ccc_1210_1211"

  concepts[penance]
    latin_name = "Paenitentia"
    label = "Penance"
    domain = "theology"
    category = "sacrament"
    note = "One of the seven sacraments of the New Law; specific signs and effects require separate cited records."
    source_id = "ccc_1210_1211"

  concepts[anointing_of_sick]
    latin_name = "Unctio infirmorum"
    label = "Anointing of the Sick"
    domain = "theology"
    category = "sacrament"
    note = "One of the seven sacraments of the New Law; specific signs and effects require separate cited records."
    source_id = "ccc_1210_1211"

