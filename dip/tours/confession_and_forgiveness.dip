graph_tour_steps[confession_and_forgiveness_conversion]
  tour_id = "confession_and_forgiveness"
  title = "Forgiveness includes a real turning back"
  question = "Can confession be a permission to keep doing wrong?"
  narrative = "The Catechism identifies contrition, confession, and satisfaction among the penitent's acts (1451-1460). Contrition includes rejecting the sin and resolving to amend; satisfaction seeks to repair its harm."
  qualification = "A sincere purpose of amendment is not a guarantee that a person will never fall again. Satisfaction is a response to mercy, not a payment that purchases God's forgiveness."
  source_ids = ["ccc_1451_1460", "st_iii_84_3"]
  concept_ids = ["penance", "contrition", "repentance_for_sin", "sacramental_confession", "satisfaction_for_sin", "sacramental_absolution"]
  edge_ids = ["penance_contrition", "contrition_repentance", "penance_confession", "penance_satisfaction", "penance_absolution"]
  highlighted_concept_ids = ["contrition", "sacramental_confession", "satisfaction_for_sin"]
  highlighted_edge_ids = ["penance_contrition", "contrition_repentance", "penance_confession", "penance_satisfaction", "penance_absolution"]
  focus_concept = "contrition"
  camera_z = 36.0

