graph_tour_steps[confession_and_forgiveness_ministry]
  tour_id = "confession_and_forgiveness"
  title = "Absolution is a ministerial act"
  question = "What does the priest mean by absolving?"
  narrative = "Aquinas explains absolution as an effective sacramental act performed ministerially (ST III, q. 84, a. 3, replies 3-5). The Catechism describes the confessor as the servant of God's forgiveness (1466)."
  qualification = "This is the Catholic account of an entrusted ministry. The sacramental sign points to God's mercy, not the priest's personal moral superiority."
  source_ids = ["st_iii_84_3", "ccc_1461_1467", "st_iii_48_1_6"]
  concept_ids = ["penance", "sacramental_absolution", "remission_of_sin", "christ_passion", "son"]
  edge_ids = ["penance_absolution", "absolution_remission", "passion_remission", "passion_son"]
  highlighted_concept_ids = ["sacramental_absolution", "remission_of_sin", "christ_passion"]
  highlighted_edge_ids = ["absolution_remission", "passion_remission"]
  focus_concept = "sacramental_absolution"
  camera_z = 36.0

