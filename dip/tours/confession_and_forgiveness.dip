# Focused, cited explanations. Coordinates are reading aids, not doctrinal claims.

graph_tour_steps[confession_and_forgiveness_source]
  tour_id = "confession_and_forgiveness"
  title = "God is the source of forgiveness"
  question = "Does a minister replace God?"
  narrative = "The Catechism begins its explanation with God's authority to forgive and Christ's entrusting of a ministry of reconciliation (1441-1442). Aquinas distinguishes God as principal cause of grace from sacramental instruments (ST III, q. 62, a. 1)."
  qualification = "The route through grace and sacrament explains different kinds of agency. It does not transfer divine power to a minister independently of God."
  source_ids = ["ccc_1441_1449", "st_iii_62_1", "ccc_1210_1211", "st_iii_86_1_6"]
  concept_ids = ["god", "grace", "sacrament", "penance", "remission_of_sin"]
  edge_ids = ["god_principal_cause_of_grace", "sacrament_instrumental_grace", "penance_sacrament", "penance_remits_sin"]
  highlighted_concept_ids = ["god", "penance", "remission_of_sin"]
  highlighted_edge_ids = ["god_principal_cause_of_grace", "penance_remits_sin"]
  focus_concept = "god"
  camera_z = 36.0

