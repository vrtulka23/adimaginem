graph_tour_steps[careful_terms_spirit]
  tour_id = "careful_terms"
  title = "Spiritual does not mean divine"
  question = "How are soul, angel, and God distinguished?"
  narrative = "An angel is a spiritual creature; the human rational soul is the form of a body. God is the creator of angels."
  qualification = "Being spiritual does not erase the creator-creature distinction or make the human soul an angel."
  concept_ids = ["god", "angel", "spiritual_creature", "rational_soul", "human_body", "human_person"]
