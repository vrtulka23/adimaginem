graph_tour_steps[careful_terms_person]
  tour_id = "careful_terms"
  title = "Person in Trinitarian language"
  question = "Does person mean a separate divine being?"
  narrative = "Father and Son are personally distinct while having the one divine essence. Aquinas explains the divine person as a subsisting relation."
  qualification = "The word person is applied with theological distinctions; the graph does not posit three specimens of the divine species."
  concept_ids = ["father", "son", "divine_essence"]
  edge_ids = ["father_distinct_from_son", "father_one_essence", "son_one_essence"]
