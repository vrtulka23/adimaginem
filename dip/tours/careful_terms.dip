graph_tour_steps[careful_terms_substance]
  tour_id = "careful_terms"
  title = "Substance and qualities"
  question = "Does substance mean chemical material?"
  narrative = "The human person is a substance; habits are qualities, and qualities are accidents. Here accident means what exists in a subject."
  qualification = "Substance is not limited to chemistry, and accident does not mean an unexpected mishap."
  concept_ids = ["human_person", "substance", "quality", "accident", "habit"]
  edge_ids = ["human_substance", "quality_accident", "habit_quality", "accident_in_substance"]
  highlighted_concept_ids = ["human_person", "substance", "quality", "accident", "habit"]
