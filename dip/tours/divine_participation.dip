graph_tour_steps[divine_participation_procession]
  tour_id = "divine_participation"
  title = "Different expressions of procession"
  question = "What does the Latin formula intend?"
  narrative = "Aquinas describes Father and Son as one principle of the Spirit's procession. The Catechism explains the Eastern emphasis on the Father as first origin and the Latin expression through their communion."
  qualification = "CCC 248 discusses legitimate complementarity. The arrows encode the cited Latin account, not a verdict that all Orthodox objections are merely verbal."
  concept_ids = ["holy_spirit", "father", "son", "common_spiration"]
  edge_ids = ["holy_spirit_proceeds_from_father", "holy_spirit_proceeds_from_son", "spiration_common_to_father", "spiration_common_to_son"]
  highlighted_concept_ids = ["holy_spirit", "father", "son", "common_spiration"]
  highlighted_edge_ids = ["holy_spirit_proceeds_from_father", "holy_spirit_proceeds_from_son", "spiration_common_to_father", "spiration_common_to_son"]
  source_ids = ["ccc_248", "st_i_36_4", "ccc_246"]
  focus_concept = "holy_spirit"
  camera_z = 36

