# Cited editorial scenes; positions are display coordinates, not theological distances.

graph_tour_steps[divine_participation_grace]
  tour_id = "divine_participation"
  title = "Grace and participation"
  question = "What changes when a creature shares in divine life?"
  narrative = "Sanctifying grace is received in the soul. Aquinas distinguishes this gift from the virtues that perfect its powers."
  qualification = "Participation does not turn a creature into the divine essence. This is the Thomistic account of the received gift, not a comprehensive account of Eastern terminology."
  concept_ids = ["god", "sanctifying_grace", "rational_soul", "virtue"]
  edge_ids = ["god_bestows_sanctifying_grace", "grace_in_soul", "grace_distinct_from_virtue"]
  highlighted_concept_ids = ["god", "sanctifying_grace", "rational_soul", "virtue"]
  highlighted_edge_ids = ["god_bestows_sanctifying_grace", "grace_in_soul", "grace_distinct_from_virtue"]
  source_ids = ["ur_17", "ccc_1996_2000", "st_i_ii_110_4", "st_i_ii_110_3"]
  focus_concept = "sanctifying_grace"
  camera_z = 36

