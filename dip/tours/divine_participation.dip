graph_tour_steps[divine_participation_love]
  tour_id = "divine_participation"
  title = "Charity and spiritual judgment"
  question = "How does love shape wisdom?"
  narrative = "Charity has its subject in the will and gives a connaturality with divine things from which the gift of wisdom judges."
  qualification = "The connection concerns judgment through shared love of the good; it does not remove the distinction between will and intellect."
  concept_ids = ["charity_virtue", "will", "wisdom_gift", "intellectual_power", "rational_soul", "appetitive_power"]
  edge_ids = ["charity_in_will", "charity_grounds_wisdom", "wisdom_in_intellect", "soul_intellectual_power", "soul_appetitive_power", "will_kind"]
  highlighted_concept_ids = ["charity_virtue", "will", "wisdom_gift", "intellectual_power"]
  highlighted_edge_ids = ["charity_in_will", "charity_grounds_wisdom", "wisdom_in_intellect"]
  source_ids = ["st_ii_ii_24_1", "st_ii_ii_45_2", "st_i_78_1", "st_i_80_2", "st_i_76_1"]
  focus_concept = "wisdom_gift"
  camera_z = 36.0

