# Focused, cited explanations. Coordinates are reading aids, not doctrinal claims.

graph_tour_steps[scripture_and_tradition_transmission]
  tour_id = "scripture_and_tradition"
  title = "One revelation, distinct modes of transmission"
  question = "Are Scripture and Tradition rival revelations?"
  narrative = "Dei Verbum 9-10 presents Scripture and apostolic Tradition as intimately connected in handing on the one divine revelation. The Catechism distinguishes the inspired written word from its living apostolic transmission (80-82)."
  qualification = "These are Catholic claims about transmission. Showing two nodes does not imply two gods, two unrelated messages, or an authority to contradict Scripture."
  source_ids = ["dei_verbum_6_10", "ccc_80_83", "ccc_65_67"]
  concept_ids = ["sacred_scripture", "divine_revelation", "sacred_tradition", "son"]
  edge_ids = ["scripture_transmits", "tradition_transmits", "scripture_tradition_distinct", "revelation_christ"]
  highlighted_concept_ids = ["sacred_scripture", "sacred_tradition", "divine_revelation"]
  highlighted_edge_ids = ["scripture_transmits", "tradition_transmits"]
  focus_concept = "sacred_scripture"
  camera_z = 36.0

