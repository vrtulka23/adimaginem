graph_tour_steps[scripture_and_tradition_customs]
  tour_id = "scripture_and_tradition"
  title = "Apostolic Tradition and local customs"
  question = "Is every inherited Catholic practice unchangeable?"
  narrative = "Catechism 83 distinguishes apostolic Tradition from particular theological, disciplinary, liturgical, and devotional traditions. Such particular forms can be retained, changed, or abandoned under the Church's guidance."
  qualification = "The graph's Sacred Tradition node denotes apostolic transmission. The scene does not classify every custom or resolve a particular dispute about whether a practice can change."
  source_ids = ["ccc_80_83", "ccc_84_87"]
  concept_ids = ["sacred_tradition", "divine_revelation", "deposit_of_faith", "sacred_scripture"]
  edge_ids = ["tradition_transmits", "tradition_deposit", "scripture_deposit", "scripture_tradition_distinct"]
  highlighted_concept_ids = ["sacred_tradition", "deposit_of_faith"]
  highlighted_edge_ids = ["tradition_deposit"]
  focus_concept = "sacred_tradition"
