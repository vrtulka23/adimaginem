graph_tour_steps[scripture_and_tradition_service]
  tour_id = "scripture_and_tradition"
  title = "The teaching office serves the Word"
  question = "Can the Magisterium invent a different revelation?"
  narrative = "Dei Verbum 10 describes the Magisterium as serving the word of God by guarding and faithfully explaining what has been handed on. Scripture and Tradition transmit the deposit which it authentically interprets."
  qualification = "This diagram does not make every statement by a church official infallible. It presents the teaching office's relation to the received deposit; the authority of a particular statement requires its own assessment."
  source_ids = ["dei_verbum_6_10", "ccc_84_87"]
  concept_ids = ["magisterium", "deposit_of_faith", "sacred_scripture", "sacred_tradition", "church"]
  edge_ids = ["magisterium_deposit", "scripture_deposit", "tradition_deposit", "church_magisterium"]
  highlighted_concept_ids = ["magisterium", "deposit_of_faith"]
  highlighted_edge_ids = ["magisterium_deposit"]
  focus_concept = "magisterium"
  camera_z = 36.0

