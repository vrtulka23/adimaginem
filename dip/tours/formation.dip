graph_tour_steps[formation_gift]
  tour_id = "formation"
  title = "Grace and virtue"
  question = "What does God give?"
  narrative = "God gives sanctifying grace and infuses theological virtues. Aquinas distinguishes grace in the soul from virtue as a principle of good activity."
  qualification = "These distinctions explain received gifts; they do not divide the person into separate spiritual containers."
  concept_ids = ["god", "sanctifying_grace", "theological_virtue", "virtue"]
  edge_ids = ["god_bestows_sanctifying_grace", "god_infuses_theological_virtues", "grace_distinct_from_virtue"]
  source_ids = ["ccc_1996_2000", "ccc_1812_1813", "st_i_ii_110_3"]
  focus_concept = "god"
  camera_z = 36.0

