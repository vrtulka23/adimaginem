# Cited editorial scenes; positions are display coordinates, not theological distances.

graph_tour_steps[formation_human]
  tour_id = "formation"
  title = "Begin with the whole person"
  question = "Who receives the gift of grace?"
  narrative = "The human person has bodily life through a rational soul. Catholic formation concerns the whole person."
  qualification = "Soul and body are not two independently complete human beings."
  concept_ids = ["human_person", "human_body", "rational_soul"]
  edge_ids = ["person_has_body", "person_has_form", "soul_actualizes_body"]
