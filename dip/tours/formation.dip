graph_tour_steps[formation_growth]
  tour_id = "formation"
  title = "Life begins and is nourished"
  question = "How does sacramental life develop?"
  narrative = "Baptism gives spiritual regeneration, and the Eucharist nourishes spiritual life. Aquinas uses the analogy of birth and nourishment to explain their different effects."
  qualification = "This is an analogy of supernatural life; sacramental effects are not biological measurements."
  concept_ids = ["baptism", "spiritual_regeneration", "spiritual_life", "eucharist"]
  edge_ids = ["baptism_regenerates", "regeneration_begins_spiritual_life", "eucharist_nourishes_life"]
  source_ids = ["st_iii_65_1", "ccc_1127_1129"]
  focus_concept = "spiritual_life"
  camera_z = 36.0

