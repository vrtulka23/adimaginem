# Cited editorial scenes; positions are display coordinates, not theological distances.

graph_tour_steps[mary_christ_theotokos]
  tour_id = "mary_christ"
  title = "Theotokos: who was born of Mary?"
  question = "How can a human creature be Mother of God?"
  narrative = "The eternal Son assumes human nature and is born of Mary. Aquinas explains that motherhood concerns the person born, even though his birth from Mary is according to humanity."
  qualification = "Theotokos means God-bearer or Mother of God; Latin Dei Genetrix. Mary is neither the source of divinity nor mother of the Father or Holy Spirit."
  concept_ids = ["virgin_mary", "son", "divine_motherhood", "human_nature"]
  edge_ids = ["mary_mother_son", "mary_theotokos", "son_assumes_human_nature"]
  source_ids = ["st_iii_35_4", "ccc_464_469"]
  focus_concept = "divine_motherhood"
  camera_z = 36.0

