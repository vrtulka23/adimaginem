graph_tour_steps[mary_christ_assumption]
  tour_id = "mary_christ"
  title = "Body and soul in glory"
  question = "What does the Assumption affirm?"
  narrative = "The Church teaches that Mary was taken body and soul into heavenly glory at the completion of her earthly life. Her glorification anticipates the resurrection of other Christians."
  qualification = "The defined formula does not settle the manner of her death. Mary remains a redeemed creature."
  concept_ids = ["virgin_mary", "assumption_of_mary", "heaven", "beatific_vision"]
  edge_ids = ["mary_assumption", "assumption_heaven", "heaven_includes_vision"]
  source_ids = ["ccc_963_975", "ccc_1023_1029"]
  focus_concept = "assumption_of_mary"
  camera_z = 36.0

