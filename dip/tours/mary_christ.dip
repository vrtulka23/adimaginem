graph_tour_steps[mary_christ_virgin]
  tour_id = "mary_christ"
  title = "The virgin mother"
  question = "What does perpetual virginity affirm?"
  narrative = "Aquinas affirms Mary's virginity before, in, and after Christ's birth. The Church confesses her as the ever-virgin mother of the incarnate Son."
  qualification = "This confession concerns Christ's human birth; it must be distinguished from Mary's own conception."
  concept_ids = ["virgin_mary", "perpetual_virginity", "son", "immaculate_conception"]
  edge_ids = ["mary_virginity", "mary_mother_son", "immaculate_distinct_virginity"]
  source_ids = ["st_iii_28_1_3", "st_iii_35_4", "ccc_484_495"]
  focus_concept = "perpetual_virginity"
  camera_z = 36.0

