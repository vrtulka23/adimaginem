graph_tour_steps[mary_christ_immaculate]
  tour_id = "mary_christ"
  title = "Redeemed by preservation"
  question = "What does the Immaculate Conception concern?"
  narrative = "Catholic teaching holds that Mary was preserved from original sin from her first conception through Christ's merits. Her holiness is a gift received from God."
  qualification = "ST III q. 27 a. 2 instead places sanctification after contracting original sin. The later dogma is not presented as Aquinas's own conclusion in that article."
  concept_ids = ["virgin_mary", "immaculate_conception", "original_sin", "sanctifying_grace"]
  edge_ids = ["mary_immaculate", "mary_preserved_original_sin", "mary_receives_grace"]
  source_ids = ["st_iii_27_2", "ccc_484_495"]
  focus_concept = "immaculate_conception"
  camera_z = 36.0

