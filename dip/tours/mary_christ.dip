graph_tour_steps[mary_christ_worship]
  tour_id = "mary_christ"
  title = "Dulia, hyperdulia, and latria"
  question = "How does veneration differ from worship of God?"
  narrative = "Aquinas reserves latria for God. Mary receives the singular veneration called hyperdulia; saints receive honor as God's servants."
  qualification = "The distinction concerns the kind and object of honor, not merely how intense a feeling of devotion is."
  concept_ids = ["marian_veneration", "virgin_mary", "divine_adoration", "god", "veneration_of_saints"]
  edge_ids = ["hyperdulia_mary", "hyperdulia_not_latria", "latria_god", "dulia_not_latria"]
  source_ids = ["st_iii_25_5_6"]
  focus_concept = "divine_adoration"
  camera_z = 36.0

