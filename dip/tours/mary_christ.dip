graph_tour_steps[mary_christ_intercession]
  tour_id = "mary_christ"
  title = "Asking Mary and the saints to pray"
  question = "Does intercession compete with Christ?"
  narrative = "The blessed intercede before God. Mary's maternal intercession is a particular form of this prayer and depends entirely on Christ's unique mediation."
  qualification = "Invoking a saint asks for prayer; it does not attribute an independent power to bestow grace to the saint."
  concept_ids = ["virgin_mary", "marian_intercession", "saints_intercession", "christ_mediation", "god"]
  edge_ids = ["mary_can_intercede", "marian_intercession_kind", "marian_intercession_depends_christ", "saints_intercession_to_god"]
  source_ids = ["lg_60_67", "ccc_963_975", "st_ii_ii_83_4_11"]
  focus_concept = "marian_intercession"
  camera_z = 36.0

