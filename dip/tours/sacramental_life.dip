graph_tour_steps[sacramental_life_reconciliation]
  tour_id = "sacramental_life"
  title = "Forgiveness within sacramental life"
  question = "What does Penance include?"
  narrative = "Penance includes the penitent's contrition and the minister's absolution. Its effect is remission of sin through Christ."
  qualification = "Receiving forgiveness calls for the requisite disposition; the diagram does not substitute for the sacrament."
  concept_ids = ["penance", "contrition", "sacramental_absolution", "remission_of_sin", "christ_passion"]
  edge_ids = ["penance_contrition", "penance_absolution", "absolution_remission", "passion_remission"]
