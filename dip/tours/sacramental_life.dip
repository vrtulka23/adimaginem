# Cited editorial scenes; positions are display coordinates, not theological distances.

graph_tour_steps[sacramental_life_cause]
  tour_id = "sacramental_life"
  title = "God acts through sacramental signs"
  question = "Who gives the grace of a sacrament?"
  narrative = "God is the principal cause of grace. Aquinas calls the sacrament an instrumental cause, acting through divine power."
  qualification = "Instrumental causality does not make a sacrament an independent source of supernatural life."
  concept_ids = ["god", "grace", "sacrament", "son"]
  edge_ids = ["god_principal_cause_of_grace", "sacrament_instrumental_grace", "sacraments_instituted_by_christ"]
  highlighted_concept_ids = ["god", "grace", "sacrament", "son"]
  highlighted_edge_ids = ["god_principal_cause_of_grace", "sacrament_instrumental_grace", "sacraments_instituted_by_christ"]
  source_ids = ["st_iii_62_1", "ccc_1114_1116"]
  focus_concept = "sacrament"
  camera_z = 36

