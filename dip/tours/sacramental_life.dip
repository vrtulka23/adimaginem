graph_tour_steps[sacramental_life_initiation]
  tour_id = "sacramental_life"
  title = "Beginning, strengthening, nourishment"
  question = "Why several sacraments of initiation?"
  narrative = "Aquinas compares Baptism with birth, Confirmation with strengthening, and the Eucharist with nourishment of spiritual life."
  qualification = "The analogy distinguishes effects; it does not make grace a material substance consumed in measurable amounts."
  concept_ids = ["baptism", "spiritual_regeneration", "spiritual_life", "confirmation", "eucharist"]
  edge_ids = ["baptism_regenerates", "regeneration_begins_spiritual_life", "confirmation_strengthens_life", "eucharist_nourishes_life"]
