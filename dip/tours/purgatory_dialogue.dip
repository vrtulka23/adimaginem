graph_tour_steps[purgatory_dialogue_saved]
  tour_id = "purgatory_dialogue"
  title = "Purification of the saved"
  question = "What is the state of the souls being purified?"
  narrative = "Those in Purgatory died in grace. Their final purification prepares them for Heaven."
  qualification = "No uncertainty of final salvation, duration, temperature, or physical mechanism is encoded."
