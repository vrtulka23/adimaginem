graph_tour_steps[purgatory_dialogue_forgiveness]
  tour_id = "purgatory_dialogue"
  title = "Forgiven guilt and remaining consequences"
  question = "Why speak of purification if sins have been forgiven?"
  narrative = "Aquinas distinguishes forgiveness from complete removal of sin's consequences. The Catechism distinguishes temporal punishment from eternal punishment."
  qualification = "Temporal punishment here concerns purification from sinful attachment; the diagram does not assert that Christ's redemption is insufficient."
  concept_ids = ["remission_of_sin", "purification_from_sin", "temporal_punishment", "eternal_punishment"]
  edge_ids = ["remission_distinct_purification", "purification_temporal", "temporal_distinct_eternal"]
  highlighted_concept_ids = ["remission_of_sin", "purification_from_sin", "temporal_punishment", "eternal_punishment"]
  highlighted_edge_ids = ["remission_distinct_purification", "purification_temporal", "temporal_distinct_eternal"]
  source_ids = ["st_iii_86_1_6", "st_appendix_purgatory", "ccc_1471_1479"]
  focus_concept = "purification_from_sin"
  camera_z = 36

