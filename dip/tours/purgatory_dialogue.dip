graph_tour_steps[purgatory_dialogue_resurrection]
  tour_id = "purgatory_dialogue"
  title = "The hope includes the body"
  question = "Does Christian hope end with a separated soul?"
  narrative = "The dead will rise, and the universal judgment will manifest the truth of human lives. The new creation embraces the fulfillment of humanity and the universe."
  qualification = "The resurrection includes all the dead; this does not mean that all receive the same final state."
  concept_ids = ["resurrection_of_dead", "human_person", "last_judgment", "renewed_creation", "christ_resurrection", "son"]
  edge_ids = ["resurrection_human_recipient", "resurrection_final_judgment", "renewal_resurrection", "resurrection_ours_instrumental", "resurrection_son"]
