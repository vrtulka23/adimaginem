graph_tour_steps[purgatory_dialogue_prayer]
  tour_id = "purgatory_dialogue"
  title = "Prayer for the departed"
  question = "Why do Catholics offer prayers and Masses for them?"
  narrative = "The Church offers suffrages for the departed, especially the Eucharist. The Catechism cites 2 Maccabees 12:46; Aquinas's account of suffrages explains their benefit within charity."
  qualification = "Many Protestant traditions do not receive 2 Maccabees as canonical. This tour makes the Catholic scriptural and ecclesial basis explicit rather than presuming agreement about the canon."
  concept_ids = ["suffrages_for_dead", "souls_in_purgatory", "eucharist", "communion_of_saints", "church", "eucharistic_sacrifice"]
  edge_ids = ["suffrages_recipients", "eucharist_suffrage", "communion_purifying", "church_offering", "eucharist_sacrifice", "church_communion"]
  highlighted_concept_ids = ["suffrages_for_dead", "souls_in_purgatory", "eucharist", "communion_of_saints"]
  highlighted_edge_ids = ["suffrages_recipients", "eucharist_suffrage", "communion_purifying"]
