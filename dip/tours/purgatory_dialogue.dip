# Cited editorial scenes; positions are display coordinates, not theological distances.

graph_tour_steps[purgatory_dialogue_death]
  tour_id = "purgatory_dialogue"
  title = "Death and particular judgment"
  question = "When does earthly moral life reach its end?"
  narrative = "Catholic teaching places particular judgment at death. The human soul survives bodily death, awaiting resurrection."
  qualification = "This model supplies no timetable beyond the revealed order and no spatial map of the afterlife."
  concept_ids = ["human_death", "particular_judgment", "separated_soul", "rational_soul", "human_body"]
  edge_ids = ["judgment_at_death", "death_separated_soul", "separated_soul_rational", "soul_separates_body"]
  highlighted_concept_ids = ["human_death", "particular_judgment", "separated_soul", "rational_soul"]
  highlighted_edge_ids = ["judgment_at_death", "death_separated_soul", "separated_soul_rational"]
  source_ids = ["ccc_1021_1022", "ccc_997_1001", "st_i_75_4"]
  focus_concept = "particular_judgment"
  camera_z = 36.0

