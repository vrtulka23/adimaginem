graph_tour_steps[purgatory_dialogue_ends]
  tour_id = "purgatory_dialogue"
  title = "Heaven and Hell"
  question = "Are there three equal final destinations?"
  narrative = "Heaven includes the beatific vision. Hell is definitive exclusion from this communion. Purgatory is distinct from Hell and directed toward Heaven."
  qualification = "Only those who die in God's friendship undergo Purgatory. It is not another opportunity for conversion after death."
  concept_ids = ["heaven", "beatific_vision", "hell", "purgatory"]
  edge_ids = ["heaven_includes_vision", "hell_excludes_vision", "purgatory_distinct_hell", "purgatory_to_heaven"]
  highlighted_concept_ids = ["heaven", "beatific_vision", "hell", "purgatory"]
  highlighted_edge_ids = ["heaven_includes_vision", "hell_excludes_vision", "purgatory_distinct_hell", "purgatory_to_heaven"]
  source_ids = ["ccc_1023_1029", "ccc_1033_1037", "ccc_1030_1032"]
  focus_concept = "purgatory"
  camera_z = 36

