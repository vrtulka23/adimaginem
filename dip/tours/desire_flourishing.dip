graph_tour_steps[desire_flourishing_peace]
  tour_id = "desire_flourishing"
  title = "Peace and ordered love"
  question = "What does Aquinas include in peace?"
  narrative = "Peace includes concord between persons and harmony of appetitive movements. Aquinas links true peace with charity."
  qualification = "This is a Catholic account of peace; it is not an assertion that peace and nirvana are interchangeable terms."
  concept_ids = ["peace_fruit", "charity_virtue", "concord", "appetitive_harmony"]
  edge_ids = ["peace_fruit_from_charity", "peace_includes_concord", "peace_includes_appetitive_harmony"]
  highlighted_concept_ids = ["peace_fruit", "charity_virtue", "concord", "appetitive_harmony"]
  highlighted_edge_ids = ["peace_fruit_from_charity", "peace_includes_concord", "peace_includes_appetitive_harmony"]
