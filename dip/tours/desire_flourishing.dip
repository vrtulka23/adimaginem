# Cited editorial scenes; positions are display coordinates, not theological distances.

graph_tour_steps[desire_flourishing_desire]
  tour_id = "desire_flourishing"
  title = "Love, desire, and delight"
  question = "How do responses to an apparent good differ?"
  narrative = "Aquinas distinguishes love of a perceived good, desire for an absent good, and delight in a present good. Their ordering describes different movements of appetite."
  qualification = "Apprehended good can be mistaken; the graph does not make every desire morally good."
  concept_ids = ["love_passion", "apprehended_good", "desire_passion", "joy_passion"]
  edge_ids = ["love_formal_object", "desire_formal_object", "joy_formal_object", "love_precedes_desire", "desire_precedes_joy"]
  highlighted_concept_ids = ["love_passion", "apprehended_good", "desire_passion", "joy_passion"]
  highlighted_edge_ids = ["love_formal_object", "desire_formal_object", "joy_formal_object", "love_precedes_desire", "desire_precedes_joy"]
  source_ids = ["na_2_4", "st_i_ii_26_1_2", "st_i_ii_23_4", "st_i_ii_31_1_3", "st_i_ii_25_2"]
  focus_concept = "desire_passion"
  camera_z = 36

