graph_tour_steps[desire_flourishing_passions]
  tour_id = "desire_flourishing"
  title = "Passions and moral formation"
  question = "Must flourishing eliminate emotion?"
  narrative = "Passions receive moral character through their relation to reason and will. Temperance perfects the concupiscible appetite, and fortitude the irascible appetite."
  qualification = "The Thomistic account calls for rightly ordered passions. It does not use bodily pleasure or emotional intensity alone as its moral criterion."
  concept_ids = ["temperance_virtue", "concupiscible_appetite", "fortitude_virtue", "irascible_appetite", "sensitive_appetite"]
  edge_ids = ["temperance_perfects_concupiscible", "fortitude_perfects_irascible", "concupiscible_kind", "irascible_kind"]
  highlighted_concept_ids = ["temperance_virtue", "concupiscible_appetite", "fortitude_virtue", "irascible_appetite"]
  highlighted_edge_ids = ["temperance_perfects_concupiscible", "fortitude_perfects_irascible"]
  source_ids = ["st_i_ii_24_1_3", "st_i_ii_61_2", "st_i_81_2", "st_i_80_2"]
  focus_concept = "temperance_virtue"
  camera_z = 36.0

