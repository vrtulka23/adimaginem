graph_tour_steps[grace_faith_faith]
  tour_id = "grace_faith"
  title = "Faith and charity engage our powers"
  question = "How are believing and loving related?"
  narrative = "Faith has its subject in intellect, while charity has its subject in will. Aquinas calls charity the form of faith because it orders faith's act to its due end."
  qualification = "Intellect and will are powers of one person. This Catholic account is offered for comparison with particular Protestant formulations."
  concept_ids = ["faith_virtue", "intellectual_power", "charity_virtue", "will", "rational_soul", "appetitive_power"]
  edge_ids = ["faith_in_intellect", "charity_in_will", "soul_intellectual_power", "soul_appetitive_power", "will_kind"]
  highlighted_concept_ids = ["faith_virtue", "intellectual_power", "charity_virtue", "will"]
  highlighted_edge_ids = ["faith_in_intellect", "charity_in_will"]
  source_ids = ["st_ii_ii_4_3", "st_ii_ii_4_2", "st_ii_ii_24_1", "st_i_78_1", "st_i_80_2", "st_i_76_1"]
  focus_concept = "faith_virtue"
  camera_z = 36.0

