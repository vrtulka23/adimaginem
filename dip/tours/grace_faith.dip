graph_tour_steps[grace_faith_action]
  tour_id = "grace_faith"
  title = "Love becomes action"
  question = "Where do good works enter the picture?"
  narrative = "An act of charity includes willing good to another. Beneficence expresses charity in doing good. These distinctions let us trace willing and action without treating salvation as a score of achievements."
  qualification = "The graph identifies acts and virtues; it does not measure anyone's justification."
  concept_ids = ["act_of_charity", "benevolence", "will", "beneficence"]
  edge_ids = ["charity_includes_benevolence", "benevolence_act_of_will", "beneficence_expresses_charity"]
  highlighted_concept_ids = ["act_of_charity", "benevolence", "will", "beneficence"]
  highlighted_edge_ids = ["charity_includes_benevolence", "benevolence_act_of_will", "beneficence_expresses_charity"]
  source_ids = ["st_ii_ii_27_2", "st_ii_ii_31_1"]
  focus_concept = "act_of_charity"
  camera_z = 36

