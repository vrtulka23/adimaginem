# Cited editorial scenes; positions are display coordinates, not theological distances.

graph_tour_steps[grace_faith_initiative]
  tour_id = "grace_faith"
  title = "Grace initiates conversion"
  question = "Who begins the movement toward God?"
  narrative = "God bestows grace and enables conversion. Aquinas treats justification as God moving a human person in a way appropriate to a voluntary agent."
  qualification = "The response is enabled by grace; the diagram does not make independent human effort the cause of the first gift."
  concept_ids = ["god", "grace", "human_conversion"]
  edge_ids = ["god_bestows_grace", "grace_enables_conversion", "conversion_to_god"]
  highlighted_concept_ids = ["god", "grace", "human_conversion"]
  highlighted_edge_ids = ["god_bestows_grace", "grace_enables_conversion", "conversion_to_god"]
  source_ids = ["st_i_ii_113_3_6", "ccc_2001_2005", "ccc_1996_2000"]
  focus_concept = "grace"
  camera_z = 36

