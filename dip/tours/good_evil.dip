graph_tour_steps[good_evil_freedom]
  tour_id = "good_evil"
  title = "Moral guilt and consent"
  question = "Is every harmful event a personal sin?"
  narrative = "Personal sin involves voluntary disorder. Mortal sin requires grave matter, full moral knowledge, and deliberate consent."
  qualification = "Natural suffering and personal culpability are distinct questions. These conditions are not a verdict about an individual."
  concept_ids = ["mortal_sin", "grave_matter", "full_moral_knowledge", "deliberate_consent"]
  edge_ids = ["mortal_requires_grave_matter", "mortal_requires_full_moral_knowledge", "mortal_requires_deliberate_consent"]
  source_ids = ["st_i_48_1_5", "ccc_1854_1863"]
  focus_concept = "mortal_sin"
  camera_z = 36.0

