# Cited editorial scenes; positions are display coordinates, not theological distances.

graph_tour_steps[good_evil_privation]
  tour_id = "good_evil"
  title = "Evil and a missing due good"
  question = "Does evil name a rival substance?"
  narrative = "Aquinas analyzes evil as the privation of a due good. The recorded case of original sin names loss of original justice."
  qualification = "Not every absence is an evil: lack of sight is a privation in a human being, unlike the absence of sight in a stone. This does not make suffering unreal."
  concept_ids = ["original_sin", "original_justice", "privation"]
  edge_ids = ["original_sin_privation", "original_sin_includes_privation"]
  source_ids = ["st_i_48_1_5", "ccc_404_405"]
  focus_concept = "privation"
  camera_z = 36.0

