graph_tour_steps[good_evil_healing]
  tour_id = "good_evil"
  title = "Wounded powers and conversion"
  question = "Can the person still turn toward the good?"
  narrative = "Sin can aggravate the wounds of nature without destroying the natural intellectual power. Grace enables conversion to God."
  qualification = "This route explains selected distinctions; it does not give a complete answer to why each instance of suffering occurs."
  concept_ids = ["personal_sin", "wounded_human_nature", "intellectual_power", "grace", "human_conversion", "god"]
  edge_ids = ["personal_sin_aggravates_wounds", "sin_preserves_natural_intellect", "grace_enables_conversion", "conversion_to_god"]
  source_ids = ["st_i_ii_85_1_3", "st_i_ii_113_3_6"]
  focus_concept = "human_conversion"
  camera_z = 40.0

