graph_tour_steps[trinity_word]
  tour_id = "trinity"
  title = "The eternal Word"
  question = "What do Father, Son, and generation signify here?"
  narrative = "Aquinas names the Son as the Word and explains this origin by analogy with intellectual procession. The Son is eternally from the Father. Divine generation involves neither a bodily process nor a time when the Father existed without the Son."
  qualification = "The intellectual analogy helps clarify the language; it does not make God a human mind or exhaust the mystery."
  source_ids = ["st_i_27_1_4", "st_i_34_2", "st_i_42_2", "ccc_253_254"]
  concept_ids = ["father", "son", "eternal_word", "eternal_generation", "divine_essence"]
  edge_ids = ["father_begets_son", "word_names_son", "son_by_generation", "father_coeternal_with_son", "father_one_essence", "son_one_essence"]
  highlighted_concept_ids = ["father", "son", "eternal_word", "eternal_generation"]
  highlighted_edge_ids = ["father_begets_son", "word_names_son", "son_by_generation", "father_coeternal_with_son"]
  focus_concept = "son"
  camera_z = 32.0

