graph_tour_steps[trinity_persons]
  tour_id = "trinity"
  title = "Person and essence"
  question = "How can the persons be distinct while God is one?"
  narrative = "Essence names the one divine being; person names Father, Son, or Holy Spirit in their real distinction. Each person is wholly God. Aquinas locates personal distinction in subsisting relations, without dividing the divine essence."
  qualification = "The central essence node is a concept label, not an additional person or a substance shared in portions."
  source_ids = ["ccc_253_254", "ccc_255", "st_i_29_4"]
  concept_ids = ["father", "son", "holy_spirit", "divine_essence"]
  edge_ids = ["father_one_essence", "son_one_essence", "holy_spirit_one_essence", "father_distinct_from_son", "father_distinct_from_holy_spirit", "son_distinct_from_holy_spirit"]
  highlighted_concept_ids = ["father", "son", "holy_spirit", "divine_essence"]
  highlighted_edge_ids = ["father_one_essence", "son_one_essence", "holy_spirit_one_essence", "father_distinct_from_son", "father_distinct_from_holy_spirit", "son_distinct_from_holy_spirit"]
  focus_concept = "divine_essence"
  camera_z = 32

