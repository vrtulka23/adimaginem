graph_tour_steps[trinity_love]
  tour_id = "trinity"
  title = "The Holy Spirit as personal Love"
  question = "What does it mean to call the Spirit Love?"
  narrative = "Aquinas distinguishes love as common to God from Love as a personal name of the Holy Spirit. The Spirit proceeds by way of love. In the Latin Catholic account, Father and Son are one principle of this procession."
  qualification = "This is divine, personal Love; the term does not identify the Spirit with a human emotion. This tour explains a revealed mystery rather than deriving the Trinity from reason alone."
  source_ids = ["st_i_37_1", "st_i_36_4", "st_i_32_1", "ccc_253_254"]
  concept_ids = ["father", "son", "holy_spirit", "subsistent_love", "procession_of_love", "divine_essence"]
  edge_ids = ["holy_spirit_proceeds_from_father", "holy_spirit_proceeds_from_son", "love_names_spirit", "spirit_by_love", "father_one_essence", "son_one_essence", "holy_spirit_one_essence"]
  highlighted_concept_ids = ["father", "son", "holy_spirit", "subsistent_love", "procession_of_love"]
  highlighted_edge_ids = ["holy_spirit_proceeds_from_father", "holy_spirit_proceeds_from_son", "love_names_spirit", "spirit_by_love"]
  focus_concept = "holy_spirit"
  camera_z = 33.800000000000004

