# Authored scenes and display coordinates; all visible lines reference existing cited edges.

graph_tour_steps[trinity_unity]
  tour_id = "trinity"
  title = "Begin with divine unity"
  question = "What does Catholic teaching mean by one God?"
  narrative = "The Catechism identifies the Trinity with the one God. Aquinas argues for divine unity. The God and Trinity labels in this scene name the same God, considered through different concepts."
  qualification = "The drawing does not count separate divine beings or divide God into components."
  source_ids = ["ccc_253_254", "st_i_11_3", "st_i_3_4"]
  concept_ids = ["god", "trinity", "divine_unity", "divine_essence"]
  edge_ids = ["god_same_as_trinity", "god_one", "trinity_one_essence", "god_divine_essence"]
  highlighted_concept_ids = ["god", "trinity", "divine_unity"]
  highlighted_edge_ids = ["god_same_as_trinity", "god_one"]
  focus_concept = "god"
  camera_z = 32.0

