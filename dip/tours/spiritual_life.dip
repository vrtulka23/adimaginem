# Cited editorial scenes; positions are display coordinates, not theological distances.

graph_tour_steps[spiritual_life_powers]
  tour_id = "spiritual_life"
  title = "One soul, several powers"
  question = "What do soul and faculty mean?"
  narrative = "Aquinas distinguishes the soul from its powers. Intellect and appetite name different capacities rooted in one living person."
  qualification = "A faculty is a principle of activity, not an independent spirit inside the body."
  concept_ids = ["rational_soul", "soul_power", "intellectual_power", "appetitive_power"]
  edge_ids = ["soul_distinct_from_power", "soul_intellectual_power", "soul_appetitive_power"]
  highlighted_concept_ids = ["rational_soul", "soul_power", "intellectual_power", "appetitive_power"]
  highlighted_edge_ids = ["soul_distinct_from_power", "soul_intellectual_power", "soul_appetitive_power"]
  source_ids = ["st_i_77_1", "st_i_78_1"]
  focus_concept = "rational_soul"
  camera_z = 36

