graph_tour_steps[spiritual_life_discernment]
  tour_id = "spiritual_life"
  title = "Feeling and spiritual judgment"
  question = "Can a feeling by itself establish a spiritual claim?"
  narrative = "Disordered passion can impede practical judgment. The gift of counsel perfects practical intellect; discernment involves the ordering of thought and action."
  qualification = "The Catechism cautions that feelings do not establish our state of grace. The graph is not a device for certifying spiritual experiences."
  concept_ids = ["disordered_passion", "practical_judgment", "practical_intellect", "counsel_gift", "conscience"]
  edge_ids = ["passion_impedes_judgment", "judgment_act_of_practical_intellect", "counsel_gift_specific_intellect", "conscience_intellectual_act", "passion_impedes_conscience"]
  highlighted_concept_ids = ["disordered_passion", "practical_judgment", "practical_intellect", "counsel_gift"]
  highlighted_edge_ids = ["passion_impedes_judgment", "judgment_act_of_practical_intellect", "counsel_gift_specific_intellect"]
  source_ids = ["ccc_2001_2005", "st_i_ii_77_1_2", "st_i_ii_68_4", "st_i_79_12_13", "st_i_ii_94_6"]
  focus_concept = "practical_judgment"
  camera_z = 36.0

