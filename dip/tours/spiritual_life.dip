graph_tour_steps[spiritual_life_grace]
  tour_id = "spiritual_life"
  title = "Nature and grace"
  question = "How is grace different from a natural capacity?"
  narrative = "Grace is a gift from God. Sanctifying grace perfects the soul, while actual grace names divine help in conversion and growth."
  qualification = "Natural abilities and supernatural gifts should not be identified solely because both are represented as nodes."
  concept_ids = ["god", "grace", "sanctifying_grace", "actual_grace"]
  edge_ids = ["god_bestows_grace", "sanctifying_kind_of_grace", "actual_kind_of_grace"]
  highlighted_concept_ids = ["god", "grace", "sanctifying_grace", "actual_grace"]
