graph_tour_steps[creation_duration]
  tour_id = "creation"
  title = "Dependence and a beginning in time"
  question = "Are creation and temporal beginning the same question?"
  narrative = "Aquinas distinguishes dependence by creation from a demonstration that the world began in time. He receives its temporal beginning through faith. The Catechism also teaches that God continues to sustain creatures in being."
  qualification = "The question of a first moment is distinct from the question of dependence for existence. This scene provides no chronology or physical cosmological model."
  source_ids = ["st_i_46_2", "ccc_301"]
  concept_ids = ["god", "creation", "created_being"]
  edge_ids = ["god_can_create", "god_creates_all"]
  focus_concept = "created_being"
  camera_z = 32.0

