# Authored scenes and display coordinates; all visible lines reference existing cited edges.

graph_tour_steps[creation_change]
  tour_id = "creation"
  title = "Start with natural becoming"
  question = "What is presupposed when a natural thing comes to be?"
  narrative = "In Aquinas's account of natural generation, matter is receptive to form, and form determines actuality. These are explanatory principles of becoming in an existing material order."
  qualification = "Matter and form are principles of the composite. Their separate graph labels do not picture two independently complete objects."
  source_ids = ["dpn_8", "dpn_2_7"]
  concept_ids = ["matter", "form", "natural_generation"]
  edge_ids = ["matter_potential_to_form", "form_actualizes_matter", "matter_in_generation", "form_in_generation"]
  focus_concept = "natural_generation"
  camera_z = 32.0

