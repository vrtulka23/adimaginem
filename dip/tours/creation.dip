graph_tour_steps[creation_dependence]
  tour_id = "creation"
  title = "Received being and its cause"
  question = "Why does Aquinas speak of a cause of being?"
  narrative = "Aquinas argues that what has being by participation depends on the source of being. God is considered as the universal efficient cause, and as pure act. The question concerns why creatures have being, beyond describing one natural event after another."
  qualification = "This is a philosophical argument with premises to examine. Merely drawing an arrow does not establish its conclusion."
  source_ids = ["st_i_44_1", "st_i_3_2"]
  concept_ids = ["god", "created_being", "pure_act", "efficient_cause"]
  edge_ids = ["god_creates_all", "god_pure_act", "god_efficient_cause_role"]
  focus_concept = "god"
  camera_z = 32.0

