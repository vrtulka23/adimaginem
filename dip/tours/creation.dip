graph_tour_steps[creation_creation]
  tour_id = "creation"
  title = "Creation and natural generation"
  question = "Does creation require material for God to work on?"
  narrative = "Aquinas distinguishes creation, which gives being without a presupposed material subject, from generation within the natural order. The Catechism affirms creation without pre-existing matter."
  qualification = "The absence of presupposed matter is not a description of nothing as a material or a physical state."
  source_ids = ["st_i_45_1_3", "ccc_296"]
  concept_ids = ["god", "creation", "natural_generation", "matter"]
  edge_ids = ["god_can_create", "creation_distinct_generation", "creation_no_presupposed_matter", "matter_in_generation"]
  focus_concept = "creation"
  camera_z = 32.0

