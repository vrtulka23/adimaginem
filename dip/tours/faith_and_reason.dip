# Focused, cited explanations. Coordinates are reading aids, not doctrinal claims.

graph_tour_steps[faith_and_reason_assent]
  tour_id = "faith_and_reason"
  title = "Believing engages the intellect"
  question = "Does believing mean switching off thought?"
  narrative = "Aquinas locates faith in the intellect. The Catechism describes believing as intellectual assent involving the will and divine grace (155). Faith therefore engages human understanding; it is not simply a feeling."
  qualification = "This scene identifies the subject of faith. The intellect node is a human power, not a separate person or a complete account of believing."
  source_ids = ["ccc_153_160", "st_ii_ii_4_2", "st_i_16_1_2"]
  concept_ids = ["faith_virtue", "intellectual_power", "truth_in_intellect"]
  edge_ids = ["faith_in_intellect", "intellect_ordered_truth"]
  highlighted_concept_ids = ["faith_virtue", "intellectual_power"]
  highlighted_edge_ids = ["faith_in_intellect"]
  focus_concept = "faith_virtue"
  camera_z = 36.0

