graph_tour_steps[faith_and_reason_revelation]
  tour_id = "faith_and_reason"
  title = "Understanding has more than one mode"
  question = "Must every revealed mystery be demonstrable by reason alone?"
  narrative = "Faith receives God's revelation on his authority. The Catechism distinguishes this ground of assent from signs that make belief credible (156), while encouraging deeper understanding (158). Revelation and rational inquiry have distinct roles."
  qualification = "Compatibility with reason does not mean every revealed truth is a philosophical conclusion. These links explain Catholic claims without proving them from the diagram."
  source_ids = ["ccc_153_160", "ccc_51_53", "ccc_1812_1813", "ccc_65_67"]
  concept_ids = ["divine_revelation", "god", "faith_virtue", "son"]
  edge_ids = ["revelation_god", "faith_ordered_to_god", "revelation_christ"]
  highlighted_concept_ids = ["divine_revelation", "faith_virtue"]
  highlighted_edge_ids = ["revelation_god", "faith_ordered_to_god"]
  focus_concept = "divine_revelation"
  camera_z = 36.0

