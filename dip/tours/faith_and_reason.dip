graph_tour_steps[faith_and_reason_truth]
  tour_id = "faith_and_reason"
  title = "Faith and reason seek truth"
  question = "Must a discovery of reason contradict faith?"
  narrative = "The intellect is ordered to truth. Catholic teaching affirms that genuine truth discovered through reason cannot contradict what God truly reveals (Catechism 159). Aquinas identifies God as truth itself (ST I, q. 16, a. 5)."
  qualification = "This principle does not settle every disputed interpretation or scientific claim. Identifying an apparent conflict requires examining the argument and the interpretation."
  source_ids = ["ccc_153_160", "st_ii_ii_4_2", "st_i_16_1_2", "st_i_16_3_5", "ccc_1812_1813"]
  concept_ids = ["faith_virtue", "intellectual_power", "truth_in_intellect", "truth", "god"]
  edge_ids = ["faith_in_intellect", "intellect_ordered_truth", "intellect_truth_sense", "god_truth", "faith_ordered_to_god"]
  highlighted_concept_ids = ["intellectual_power", "truth", "god"]
  highlighted_edge_ids = ["intellect_ordered_truth", "god_truth"]
  focus_concept = "intellectual_power"
  camera_z = 36.0

