graph_tour_steps[body_soul_appetite]
  tour_id = "body_soul"
  title = "Sensible appetite and will"
  question = "How are emotion and rational desire distinguished?"
  narrative = "Sensitive appetite and will are kinds of appetitive power. Choice belongs to will; passion belongs to sensitive appetite."
  qualification = "The distinction concerns the object and manner of activity, not an anatomical partition."
  concept_ids = ["sensitive_appetite", "appetitive_power", "will", "choice"]
  edge_ids = ["sensitive_appetite_kind", "will_kind", "choice_of_will"]
  source_ids = ["st_i_80_2", "st_i_83_4"]
  focus_concept = "will"
  camera_z = 36.0

