graph_tour_steps[body_soul_cognition]
  tour_id = "body_soul"
  title = "From imagination to understanding"
  question = "How does Aquinas connect embodied experience with thought?"
  narrative = "Imagination retains phantasms. Understanding turns to phantasms, while intelligible species are abstracted from them."
  qualification = "Phantasm and intelligible species are technical philosophical terms, not direct equivalents of a modern neural representation."
  concept_ids = ["phantasm", "imagination", "understanding", "intelligible_species"]
  edge_ids = ["phantasm_retained_by_imagination", "understanding_turns_to_phantasm", "intelligible_species_abstracted_from_phantasm"]
  source_ids = ["st_i_78_4", "st_i_84_7", "st_i_85_1"]
  focus_concept = "understanding"
  camera_z = 36.0

