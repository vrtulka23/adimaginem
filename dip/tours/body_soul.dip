# Cited editorial scenes; positions are display coordinates, not theological distances.

graph_tour_steps[body_soul_unity]
  tour_id = "body_soul"
  title = "A living bodily unity"
  question = "What does soul explain in Thomistic psychology?"
  narrative = "The rational soul actualizes the body as its substantial form. The person senses and understands as one living subject."
  qualification = "This philosophical account does not identify soul with a measured organ or a spatial object beside the body."
  concept_ids = ["human_person", "rational_soul", "human_body"]
  edge_ids = ["person_has_form", "soul_actualizes_body", "person_has_body"]
  source_ids = ["st_i_76_1", "st_i_75_4"]
  focus_concept = "rational_soul"
  camera_z = 36.0

