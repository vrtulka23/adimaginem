# Cited editorial scenes; positions are display coordinates, not theological distances.

graph_tour_steps[divine_being_pure_act]
  tour_id = "divine_being"
  title = "God and pure act"
  question = "Does divinity mean a higher degree of creaturely development?"
  narrative = "For Aquinas, God is pure act and has no passive potentiality awaiting fulfillment. God's active power expresses fullness of actuality."
  qualification = "Active power and passive potentiality have different meanings; the graph does not place God on a scale of developing creatures."
  concept_ids = ["god", "pure_act", "passive_potentiality", "active_power"]
  edge_ids = ["god_pure_act", "pure_act_excludes_passivity", "god_active_power"]
  source_ids = ["st_i_3_2", "st_i_3_1", "st_i_25_1"]
  focus_concept = "pure_act"
  camera_z = 36.0

