graph_tour_steps[divine_being_participation]
  tour_id = "divine_being"
  title = "Sharing in divine life"
  question = "What does deification mean in this account?"
  narrative = "God gives sanctifying grace to the soul. The soul receives this perfection while remaining a created human soul."
  qualification = "Sharing in divine life through grace is not identity with the uncreated essence or becoming an additional divine person."
  concept_ids = ["god", "sanctifying_grace", "rational_soul", "human_person"]
  edge_ids = ["god_bestows_sanctifying_grace", "grace_in_soul", "person_has_form"]
  source_ids = ["st_i_ii_110_4", "ccc_1996_2000", "st_i_76_1"]
  focus_concept = "sanctifying_grace"
  camera_z = 36.0

