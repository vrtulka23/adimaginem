graph_tour_steps[divine_being_spirits]
  tour_id = "divine_being"
  title = "Spiritual beings are creatures"
  question = "Does being immaterial make an angel divine?"
  narrative = "Angels are spiritual creatures created by God. Their immateriality does not give them God's uncreated mode of being."
  qualification = "This scene explains the Catholic distinction and does not summarize every Latter-day Saint use of the word spirit."
  concept_ids = ["god", "angel", "spiritual_creature", "created_being"]
  edge_ids = ["god_creates_angels", "angel_is_spiritual", "spiritual_is_created"]
  source_ids = ["ccc_327_330"]
  focus_concept = "angel"
  camera_z = 36.0

