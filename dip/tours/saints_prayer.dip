graph_tour_steps[saints_prayer_christ]
  tour_id = "saints_prayer"
  title = "All intercession depends on Christ"
  question = "Where does the prayer lead?"
  narrative = "The saints' intercession turns to God and depends on Christ's mediation. Invocation is distinct from divine adoration."
  qualification = "This route explains Catholic practice; it does not require a visitor to have accepted its premises before asking questions."
  concept_ids = ["saints_intercession", "god", "christ_mediation", "invocation_of_saints", "divine_adoration", "saints_in_heaven"]
  edge_ids = ["saints_intercession_to_god", "saints_intercession_depends_christ", "invocation_not_adoration", "saints_can_intercede", "invocation_saints_recipient"]
