graph_tour_steps[saints_prayer_communion]
  tour_id = "saints_prayer"
  title = "Communion across death"
  question = "What connects believers and the blessed?"
  narrative = "Catholic teaching describes one communion embracing the glorified and those being purified. The saints in Heaven remain united to Christ."
  qualification = "The graph distinguishes the blessed who are invoked from the departed for whom purification is sought."
