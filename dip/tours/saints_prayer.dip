graph_tour_steps[saints_prayer_request]
  tour_id = "saints_prayer"
  title = "Invocation asks for intercession"
  question = "What does pray to a saint mean here?"
  narrative = "An invocation asks a saint to pray to God. Invoking Mary is a particular instance, addressed to the mother of the incarnate Son."
  qualification = "Aquinas distinguishes asking God to give a good from asking a saint to obtain it by prayer. Neither Mary nor another saint becomes the principal source of grace."
  concept_ids = ["invocation_of_mary", "invocation_of_saints", "virgin_mary", "saints_in_heaven", "saints_intercession", "marian_intercession"]
  edge_ids = ["invocation_mary_kind", "invocation_mary_recipient", "invocation_saints_recipient", "saints_can_intercede", "marian_intercession_kind"]
  highlighted_concept_ids = ["invocation_of_mary", "invocation_of_saints", "virgin_mary", "saints_in_heaven"]
  highlighted_edge_ids = ["invocation_mary_kind", "invocation_mary_recipient", "invocation_saints_recipient"]
  source_ids = ["st_ii_ii_83_4_11", "ccc_963_975", "lg_60_67"]
