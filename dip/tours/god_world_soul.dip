graph_tour_steps[god_world_soul_person]
  tour_id = "god_world_soul"
  title = "The embodied person"
  question = "What is the relation between soul and body?"
  narrative = "The rational soul is the substantial form of the body. The human person is the living composite whose acts include sensing and understanding."
  qualification = "These are Thomistic terms; a comparison with atman or other traditional terms requires attention to a particular school."
  concept_ids = ["human_person", "human_body", "rational_soul", "human_nature"]
  edge_ids = ["person_has_body", "person_has_form", "soul_actualizes_body", "person_human_nature", "human_nature_soul"]
  highlighted_concept_ids = ["human_person", "human_body", "rational_soul"]
  highlighted_edge_ids = ["person_has_body", "person_has_form", "soul_actualizes_body"]
  source_ids = ["st_i_75_4", "st_i_76_1", "de_ente_1_4", "ccc_464_469"]
