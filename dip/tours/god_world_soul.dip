graph_tour_steps[god_world_soul_union]
  tour_id = "god_world_soul"
  title = "Love directed toward God"
  question = "How can union preserve personal distinction?"
  narrative = "Charity inheres in the will and is directed toward God. Loving union perfects the creature's relation to God."
  qualification = "The creature remains a creature. The tour does not identify Catholic charity with every account of liberation."
  concept_ids = ["charity_virtue", "will", "god", "act_of_charity"]
  edge_ids = ["charity_in_will", "charity_ordered_to_god", "charity_act_of_will"]
  highlighted_concept_ids = ["charity_virtue", "will", "god"]
  highlighted_edge_ids = ["charity_in_will", "charity_ordered_to_god"]
  source_ids = ["st_ii_ii_24_1", "ccc_1812_1813", "st_iii_79_1"]
  focus_concept = "charity_virtue"
