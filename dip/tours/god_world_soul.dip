graph_tour_steps[god_world_soul_creation]
  tour_id = "god_world_soul"
  title = "Dependence on the creator"
  question = "How does the world depend on God?"
  narrative = "Aquinas identifies God as the cause of creatures' being and the final good toward which creation is ordered."
  qualification = "Causal dependence is not the claim that the world is a bodily part of God."
  concept_ids = ["god", "created_being"]
  edge_ids = ["god_creates_all", "god_final_cause_of_created_being"]
