graph_tour_steps[causal_explanation_creation]
  tour_id = "causal_explanation"
  title = "Natural change and creation"
  question = "Does explaining a physical process settle every causal question?"
  narrative = "Natural generation presupposes matter. Creation, in Aquinas's sense, concerns the giving of being without a presupposed material subject."
  qualification = "The distinction does not supply an alternative physical mechanism or a cosmological timeline."
  concept_ids = ["matter", "natural_generation", "creation", "form"]
  edge_ids = ["matter_in_generation", "creation_distinct_generation", "creation_no_presupposed_matter", "form_in_generation"]
  highlighted_concept_ids = ["matter", "natural_generation", "creation"]
  highlighted_edge_ids = ["matter_in_generation", "creation_distinct_generation", "creation_no_presupposed_matter"]
  source_ids = ["dpn_8", "st_i_45_1_3", "dpn_2_7"]
  focus_concept = "creation"
  camera_z = 36.0

