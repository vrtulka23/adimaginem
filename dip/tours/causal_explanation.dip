# Cited editorial scenes; positions are display coordinates, not theological distances.

graph_tour_steps[causal_explanation_four]
  tour_id = "causal_explanation"
  title = "Four causal questions"
  question = "What does cause mean here?"
  narrative = "Aquinas distinguishes material, formal, efficient, and final causes: what something is made from, what determines its kind, what brings it about, and its end."
  qualification = "These are distinct explanatory respects, not four competing physical forces."
  concept_ids = ["material_cause", "cause", "formal_cause", "efficient_cause", "final_cause"]
  edge_ids = ["material_cause_kind", "formal_cause_kind", "efficient_cause_kind", "final_cause_kind"]
  highlighted_concept_ids = ["material_cause", "cause", "formal_cause", "efficient_cause", "final_cause"]
  highlighted_edge_ids = ["material_cause_kind", "formal_cause_kind", "efficient_cause_kind", "final_cause_kind"]
  source_ids = ["dpn_20"]
  focus_concept = "cause"
  camera_z = 36

