graph_tour_steps[causal_explanation_form]
  tour_id = "causal_explanation"
  title = "Matter and form in explanation"
  question = "How are causal roles related to natural principles?"
  narrative = "Matter has a material causal role; form has a formal causal role. Form actualizes matter within a composite."
  qualification = "Form does not mean merely external shape, and matter is not always a particular modern physical substance."
  concept_ids = ["matter", "material_cause", "form", "formal_cause"]
  edge_ids = ["matter_material_cause", "form_formal_cause", "form_actualizes_matter"]
  highlighted_concept_ids = ["matter", "material_cause", "form", "formal_cause"]
  highlighted_edge_ids = ["matter_material_cause", "form_formal_cause", "form_actualizes_matter"]
  source_ids = ["dpn_20", "dpn_8"]
  focus_concept = "form"
  camera_z = 36

