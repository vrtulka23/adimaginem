graph_tour_steps[mass_one_sacrifice_presence]
  tour_id = "mass_one_sacrifice"
  title = "What changes, and what remains"
  question = "Does sacramental presence mean only a reminder, or a visible change of appearance?"
  narrative = "Aquinas distinguishes the conversion of substance from the remaining sensible qualities of bread and wine (ST III, q. 75, aa. 1, 4-5). The Catechism teaches that the whole Christ is substantially present (1374-1376)."
  qualification = "Substance and accident are philosophical terms here. The appearance of bread and wine remains; this teaching is not a claim that laboratory observation detects ordinary flesh."
  source_ids = ["st_iii_75_1_5", "ccc_1362_1377"]
  concept_ids = ["eucharist", "real_presence", "transubstantiation", "substance", "accident"]
  edge_ids = ["eucharist_presence", "eucharist_conversion", "conversion_presence", "conversion_substance", "conversion_accidents"]
  highlighted_concept_ids = ["real_presence", "transubstantiation", "substance", "accident"]
  highlighted_edge_ids = ["conversion_presence", "conversion_substance", "conversion_accidents"]
  focus_concept = "real_presence"
  camera_z = 36.0

