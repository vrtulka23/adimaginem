# Focused, cited explanations. Coordinates are reading aids, not doctrinal claims.

graph_tour_steps[mass_one_sacrifice_memorial]
  tour_id = "mass_one_sacrifice"
  title = "The one sacrifice made present"
  question = "Does the Mass add another crucifixion?"
  narrative = "The Catechism identifies the sacrifice of the Eucharist with Christ's one sacrifice, made present sacramentally (1366-1367). Aquinas explains the celebration as a sacramental representation of the Passion through which its fruits are communicated (ST III, q. 83, a. 1)."
  qualification = "Sacramental representation here is effective, not merely a picture. Christ does not suffer a new historical death at each celebration."
  source_ids = ["st_iii_83_1", "ccc_1362_1377", "st_iii_48_1_6"]
  concept_ids = ["eucharist", "eucharistic_sacrifice", "christ_passion", "son", "church"]
  edge_ids = ["eucharist_sacrifice", "eucharist_one_sacrifice", "passion_son", "church_offering"]
  highlighted_concept_ids = ["eucharistic_sacrifice", "christ_passion"]
  highlighted_edge_ids = ["eucharist_one_sacrifice"]
  focus_concept = "eucharistic_sacrifice"
  camera_z = 36.0

