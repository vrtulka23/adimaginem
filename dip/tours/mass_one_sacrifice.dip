graph_tour_steps[mass_one_sacrifice_fruit]
  tour_id = "mass_one_sacrifice"
  title = "Communion is ordered to charity"
  question = "What is the sacrament meant to bring about in the recipient?"
  narrative = "Aquinas describes the Eucharist as spiritual nourishment which strengthens grace and charity and arouses charity to action (ST III, q. 79, a. 1). Its purpose includes living union with Christ."
  qualification = "The graph records the sacrament's proper effects, not an inevitable outcome regardless of the recipient. The Catechism distinguishes sacramental efficacy from the fruits received according to a person's disposition (1128)."
  source_ids = ["st_iii_79_1", "st_iii_65_1", "ccc_1127_1129"]
  concept_ids = ["eucharist", "spiritual_life", "charity_virtue", "act_of_charity"]
  edge_ids = ["eucharist_nourishes_life", "eucharist_increases_charity", "eucharist_arouses_charity"]
  highlighted_concept_ids = ["eucharist", "charity_virtue", "act_of_charity"]
  highlighted_edge_ids = ["eucharist_nourishes_life", "eucharist_increases_charity", "eucharist_arouses_charity"]
  focus_concept = "eucharist"
  camera_z = 36.0

