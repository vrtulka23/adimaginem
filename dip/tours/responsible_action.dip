# Cited editorial scenes; positions are display coordinates, not theological distances.

graph_tour_steps[responsible_action_good]
  tour_id = "responsible_action"
  title = "The good as apprehended"
  question = "What moves a person to choose?"
  narrative = "Will is directed toward a good as understood. Practical intellect presents an object, while will moves intellect as regards exercising its activity."
  qualification = "An apparent good may be misjudged. These relations do not guarantee that the selected action is actually good."
  concept_ids = ["will", "apprehended_good", "practical_intellect"]
  edge_ids = ["will_object", "practical_intellect_moves_will_as_to_object", "will_moves_practical_intellect_as_to_exercise"]
  source_ids = ["st_i_ii_8_1", "st_i_ii_9_1"]
  focus_concept = "will"
  camera_z = 36.0

