graph_tour_steps[responsible_action_choice]
  tour_id = "responsible_action"
  title = "Deliberation and choice"
  question = "How does practical inquiry enter action?"
  narrative = "Counsel is an act of intellect that precedes choice in the practical order. Choice is an act of will."
  qualification = "The order is explanatory; not every choice includes a lengthy conscious calculation."
  concept_ids = ["counsel", "intellectual_power", "choice", "will"]
  edge_ids = ["counsel_of_intellect", "counsel_precedes_choice", "choice_of_will"]
  source_ids = ["st_i_ii_14_1", "st_i_83_4"]
  focus_concept = "choice"
  camera_z = 36.0

