graph_tour_steps[responsible_action_character]
  tour_id = "responsible_action"
  title = "Virtue and vice"
  question = "What changes when patterns become established?"
  narrative = "Virtue is a good habit. Vice is a bad habit opposed to virtue; repeated sin can dispose a person toward vice."
  qualification = "An acquired disposition inclines action without converting this graph into a deterministic account of personal responsibility."
  concept_ids = ["virtue", "habit", "vice", "personal_sin"]
  edge_ids = ["virtue_as_habit", "vice_habit", "vice_opposes_virtue", "sin_disposes_to_vice"]
  source_ids = ["st_i_ii_55_1", "st_i_ii_71_1_6", "ccc_1865"]
  focus_concept = "habit"
  camera_z = 36.0

