graph_tour_steps[spirit_work_fruits]
  tour_id = "spirit_work"
  title = "Fruits appear in living"
  question = "How do gifts and fruits differ?"
  narrative = "Fruits name the good acts and perfections that mature in a life moved by the Spirit. Gentleness moderates anger, and patience sustains endurance."
  qualification = "A strong feeling does not by itself establish the presence or absence of sanctifying grace; CCC 2005 cautions against that inference."
  concept_ids = ["fruit_of_holy_spirit", "human_person", "gentleness_fruit", "anger_passion", "patience_fruit", "endurance_of_adversity"]
  edge_ids = ["fruits_realized_in_humans", "gentleness_moderates_anger", "patience_sustains_endurance"]
  source_ids = ["st_i_ii_70_1", "ccc_2001_2005", "st_i_ii_70_3"]
  focus_concept = "fruit_of_holy_spirit"
  camera_z = 40.0

