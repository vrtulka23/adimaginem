# Cited editorial scenes; positions are display coordinates, not theological distances.

graph_tour_steps[spirit_work_gifts]
  tour_id = "spirit_work"
  title = "Gifts dispose us to divine guidance"
  question = "What is meant by a gift here?"
  narrative = "Aquinas describes the seven gifts as abiding dispositions making a person responsive to the Holy Spirit. They perfect the exercise of virtue."
  qualification = "The seven gifts are distinguished from special charisms for serving the Church, such as prophecy or tongues; CCC 2003 supplies that further distinction."
  concept_ids = ["holy_spirit", "gift_of_holy_spirit", "habit", "virtue"]
  edge_ids = ["god_bestows_spirit_gifts", "gifts_are_habits", "gift_perfects_virtue"]
  source_ids = ["st_i_ii_68_1", "ccc_2001_2005", "ccc_1830_1831", "st_i_ii_68_3"]
  focus_concept = "gift_of_holy_spirit"
  camera_z = 36.0

