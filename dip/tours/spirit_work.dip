graph_tour_steps[spirit_work_powers]
  tour_id = "spirit_work"
  title = "Understanding and counsel"
  question = "What is perfected in the human person?"
  narrative = "Understanding concerns speculative intellect, while counsel concerns practical intellect. The gifts perfect the person's activity under divine movement."
  qualification = "These faculties are not separate persons, and the distinctions do not assign supernatural activity to brain locations."
  concept_ids = ["understanding_gift", "speculative_intellect", "counsel_gift", "practical_intellect"]
  edge_ids = ["understanding_gift_specific_intellect", "counsel_gift_specific_intellect"]
  source_ids = ["st_i_ii_68_4"]
  focus_concept = "understanding_gift"
  camera_z = 36.0

