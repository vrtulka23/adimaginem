graph_tour_steps[eternal_son_eternity]
  tour_id = "eternal_son"
  title = "An origin without a beginning"
  question = "Does being from the Father make the Son later?"
  narrative = "Aquinas distinguishes an origin from a beginning in duration. He holds the Son to be coeternal with the Father because divine generation is neither successive nor a transition from imperfection to completion."
  qualification = "The direction of the generation arrow expresses a relation of origin; it does not represent a timeline."
  source_ids = ["st_i_42_2", "st_i_27_1_4", "ccc_253_254"]
  concept_ids = ["father", "son", "eternal_generation", "divine_essence"]
  edge_ids = ["father_begets_son", "father_coeternal_with_son", "son_by_generation", "father_one_essence", "son_one_essence"]
  highlighted_concept_ids = ["father", "son", "eternal_generation"]
  highlighted_edge_ids = ["father_begets_son", "father_coeternal_with_son", "son_by_generation"]
  focus_concept = "eternal_generation"
  camera_z = 32.0

