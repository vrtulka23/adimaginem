graph_tour_steps[eternal_son_operation]
  tour_id = "eternal_son"
  title = "The common divine work"
  question = "Do the persons act as three independent creators?"
  narrative = "Aquinas teaches that creation belongs to the Trinity through the one divine essence, power, and will. The Catechism likewise describes the divine work as common to the three persons, while respecting their personal properties."
  qualification = "These lines express common divine operation. They do not add together three partial contributions to make one complete deity."
  source_ids = ["st_i_45_6", "ccc_258", "ccc_475_482"]
  concept_ids = ["father", "son", "holy_spirit", "common_divine_operation", "divine_will"]
  edge_ids = ["operation_common_to_father", "operation_common_to_son", "operation_common_to_holy_spirit", "divine_will_common_father", "divine_will_common_son", "divine_will_common_holy_spirit"]
  highlighted_concept_ids = ["father", "son", "holy_spirit", "common_divine_operation"]
  highlighted_edge_ids = ["operation_common_to_father", "operation_common_to_son", "operation_common_to_holy_spirit"]
  focus_concept = "common_divine_operation"
  camera_z = 32.0

