# Authored scenes and display coordinates; all visible lines reference existing cited edges.

graph_tour_steps[eternal_son_essence]
  tour_id = "eternal_son"
  title = "The Son is wholly divine"
  question = "What does consubstantial mean?"
  narrative = "The Catholic confession identifies the Son with the same undivided divine essence as the Father. Father and Son are personally distinct. Their distinction does not place the Son in a lesser grade of divinity."
  qualification = "The one essence is not a genus containing two separate gods."
  source_ids = ["ccc_240_245", "ccc_253_254", "st_i_29_4"]
  concept_ids = ["father", "son", "divine_essence"]
  edge_ids = ["father_one_essence", "son_one_essence", "father_distinct_from_son"]
  highlighted_concept_ids = ["father", "son", "divine_essence"]
  highlighted_edge_ids = ["father_one_essence", "son_one_essence", "father_distinct_from_son"]
  focus_concept = "son"
  camera_z = 32

