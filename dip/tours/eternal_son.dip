graph_tour_steps[eternal_son_spirit]
  tour_id = "eternal_son"
  title = "The Spirit is a divine person"
  question = "How does the Holy Spirit belong to divine life?"
  narrative = "The Catechism confesses the Holy Spirit as a divine person, equal in divinity with Father and Son. Aquinas uses Love as a personal name of the Spirit. Personal distinction and unity of essence remain together."
  qualification = "The concept of personal Love expresses the Spirit's identity and origin, rather than reducing the Spirit to an impersonal effect."
  source_ids = ["ccc_240_245", "st_i_37_1", "ccc_255"]
  concept_ids = ["father", "son", "holy_spirit", "divine_essence", "subsistent_love"]
  edge_ids = ["father_one_essence", "son_one_essence", "holy_spirit_one_essence", "son_distinct_from_holy_spirit", "love_names_spirit"]
  highlighted_concept_ids = ["father", "son", "holy_spirit", "divine_essence", "subsistent_love"]
  highlighted_edge_ids = ["father_one_essence", "son_one_essence", "holy_spirit_one_essence", "son_distinct_from_holy_spirit", "love_names_spirit"]
  focus_concept = "holy_spirit"
  camera_z = 32

