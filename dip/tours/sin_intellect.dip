graph_tour_steps[sin_intellect_absolution]
  tour_id = "sin_intellect"
  title = "Confession and sacramental absolution"
  question = "How is post-baptismal sin forgiven sacramentally?"
  narrative = "In Penance the penitent turns from sin and confesses it; the authorized priest absolves in Christ's name. Aquinas understands absolution as instrumental in God's forgiveness."
  qualification = "Contrition includes resolve to amend. Perfect contrition reconciles when it includes the intention of sacramental confession as soon as possible; it is not permission to dispense with confession."
  concept_ids = ["penance", "contrition", "sacramental_confession", "sacramental_absolution", "remission_of_sin"]
  edge_ids = ["penance_contrition", "penance_confession", "penance_absolution", "absolution_remission"]
  highlighted_concept_ids = ["penance", "contrition", "sacramental_confession", "sacramental_absolution", "remission_of_sin"]
  highlighted_edge_ids = ["penance_contrition", "penance_confession", "penance_absolution", "absolution_remission"]
  source_ids = ["ccc_1451_1460", "ccc_1461_1467", "st_iii_84_3"]
  focus_concept = "sacramental_absolution"
  camera_z = 36

