graph_tour_steps[sin_intellect_healing]
  tour_id = "sin_intellect"
  title = "Forgiveness and continuing healing"
  question = "Why can bad inclinations remain after absolution?"
  narrative = "Aquinas distinguishes remission of guilt from removal of all residual dispositions and temporal consequences. Satisfaction and reparation belong to healing after forgiveness."
  qualification = "Continuing struggles do not by themselves show that absolution failed. Restoration of virtue and repair of harm continue through grace and action."
  concept_ids = ["penance", "satisfaction_for_sin", "remnants_of_sin", "remission_of_sin", "purification_from_sin", "sacramental_absolution"]
  edge_ids = ["penance_satisfaction", "satisfaction_remnants", "remission_distinct_purification", "penance_absolution", "absolution_remission"]
  highlighted_concept_ids = ["penance", "satisfaction_for_sin", "remnants_of_sin", "remission_of_sin", "purification_from_sin"]
  highlighted_edge_ids = ["penance_satisfaction", "satisfaction_remnants", "remission_distinct_purification"]
  source_ids = ["st_iii_86_1_6", "ccc_1451_1460", "st_iii_84_3"]
