# Cited editorial scenes; positions are display coordinates, not theological distances.

graph_tour_steps[sin_intellect_subject]
  tour_id = "sin_intellect"
  title = "Where is sin in a person?"
  question = "Is sin a substance stored inside the intellect?"
  narrative = "Aquinas locates a sinful act in the power from which the voluntary act proceeds: principally will, and also reason or appetite insofar as their activity can be voluntary. Vice is an abiding bad disposition, distinguished from an individual act."
  qualification = "This is a moral and metaphysical account of subject, not a physical location. An involuntary intellectual error does not by itself establish personal guilt."
  concept_ids = ["personal_sin", "will", "intellectual_power", "vice", "habit"]
  edge_ids = ["sin_subject_will", "sin_subject_intellectual_power", "vice_habit", "vice_inclines_sin"]
  highlighted_concept_ids = ["personal_sin", "will", "intellectual_power", "vice", "habit"]
  highlighted_edge_ids = ["sin_subject_will", "sin_subject_intellectual_power", "vice_habit"]
  source_ids = ["st_i_ii_74_1_5", "st_i_ii_113_3_6", "st_i_83_4", "st_i_ii_71_1_6", "ccc_1865"]
  focus_concept = "will"
  camera_z = 36

graph_tour_steps[sin_intellect_wounds]
  tour_id = "sin_intellect"
  title = "The intellect is wounded, not destroyed"
  question = "What is corrupted by sin?"
  narrative = "Aquinas names ignorance as a wound of the intellect's order toward truth and malice as a wound of will toward good. Personal sin can deepen these disorders."
  qualification = "The natural faculties remain. Original sin is an inherited condition; it is not a personal act committed by each descendant."
  concept_ids = ["ignorance_wound", "intellectual_power", "malice_wound", "will", "personal_sin", "wounded_human_nature"]
  edge_ids = ["ignorance_wound_power", "malice_wound_power", "sin_preserves_natural_intellect", "wounded_nature_ignorance_wound", "wounded_nature_malice_wound", "personal_sin_aggravates_wounds"]
  highlighted_concept_ids = ["ignorance_wound", "intellectual_power", "malice_wound", "will", "personal_sin"]
  highlighted_edge_ids = ["ignorance_wound_power", "malice_wound_power", "sin_preserves_natural_intellect"]
  source_ids = ["st_i_ii_85_1_3", "ccc_404_405"]
  focus_concept = "intellectual_power"
  camera_z = 36.0

