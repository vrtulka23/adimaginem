graph_tour_steps[sin_intellect_judgment]
  tour_id = "sin_intellect"
  title = "How judgment becomes clouded"
  question = "How can desire affect what seems reasonable?"
  narrative = "Disordered passion can impede practical judgment. Repeated wrongdoing disposes to vice, which inclines toward further sin. Aquinas also distinguishes spiritual blindness and dullness of understanding."
  qualification = "The cited blindness concerns spiritual judgment. It is not a claim that every intellectual difficulty or disability results from a person's sins."
  concept_ids = ["disordered_passion", "practical_judgment", "blindness_of_mind", "understanding", "personal_sin", "vice", "intellectual_power", "practical_intellect"]
  edge_ids = ["passion_impedes_judgment", "blindness_of_mind_impedes", "sin_disposes_to_vice", "vice_inclines_sin", "understanding_of_intellect", "judgment_act_of_practical_intellect", "practical_intellect_is_intellectual", "sin_subject_intellectual_power"]
  highlighted_concept_ids = ["disordered_passion", "practical_judgment", "blindness_of_mind", "understanding", "personal_sin", "vice"]
  highlighted_edge_ids = ["passion_impedes_judgment", "blindness_of_mind_impedes", "sin_disposes_to_vice", "vice_inclines_sin"]
  source_ids = ["st_ii_ii_15_1_2", "st_i_ii_77_1_2", "ccc_1865", "st_i_84_7", "st_i_79_11", "st_i_ii_74_1_5", "st_i_78_1"]
  focus_concept = "practical_judgment"
  camera_z = 40.0

