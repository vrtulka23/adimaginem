graph_tour_steps[sin_intellect_conversion]
  tour_id = "sin_intellect"
  title = "Grace moves the return"
  question = "How can the wounded person turn back?"
  narrative = "God initiates justification. Grace enables conversion, and justification includes turning toward God and repentance for sin."
  qualification = "For an adult capable of voluntary acts, this movement includes a free response under grace; it is not self-rescue by intellect alone."
  concept_ids = ["justification", "god", "human_conversion", "repentance_for_sin", "grace"]
  edge_ids = ["justification_from_god", "justification_includes_human_conversion", "justification_includes_repentance_for_sin", "grace_enables_conversion"]
  highlighted_concept_ids = ["justification", "god", "human_conversion", "repentance_for_sin", "grace"]
  highlighted_edge_ids = ["justification_from_god", "justification_includes_human_conversion", "justification_includes_repentance_for_sin", "grace_enables_conversion"]
  source_ids = ["st_i_ii_113_3_6"]
  focus_concept = "justification"
  camera_z = 36

