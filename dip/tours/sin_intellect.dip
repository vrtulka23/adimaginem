graph_tour_steps[sin_intellect_gravity]
  tour_id = "sin_intellect"
  title = "Mortal and venial sin"
  question = "What is lost, and under what conditions?"
  narrative = "Mortal sin involves grave matter, full knowledge, and deliberate consent, and deprives the person of sanctifying grace. Venial sin weakens charity while leaving grace intact."
  qualification = "A graph of necessary conditions cannot judge an individual's conscience or degree of consent."
  concept_ids = ["mortal_sin", "sanctifying_grace", "venial_sin", "charity_virtue"]
  edge_ids = ["mortal_deprives_sanctifying_grace", "venial_preserves_grace", "venial_weakens_charity"]
  highlighted_concept_ids = ["mortal_sin", "sanctifying_grace", "venial_sin", "charity_virtue"]
  highlighted_edge_ids = ["mortal_deprives_sanctifying_grace", "venial_preserves_grace", "venial_weakens_charity"]
  source_ids = ["ccc_1854_1863"]
  focus_concept = "mortal_sin"
  camera_z = 36

