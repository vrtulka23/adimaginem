graph_tour_steps[jewish_dialogue_persons]
  tour_id = "jewish_dialogue"
  title = "What Christians mean by personal distinction"
  question = "What is being asserted when Catholics name Father and Son?"
  narrative = "Catholic teaching identifies Father and Son with one divine essence while distinguishing them personally. Aquinas explains divine person through subsisting relation."
  qualification = "This is an explanation of Christian confession, not a claim that Jewish interlocutors already accept it."
  concept_ids = ["father", "divine_essence", "son", "trinity"]
  edge_ids = ["father_one_essence", "son_one_essence", "father_distinct_from_son", "trinity_one_essence"]
  highlighted_concept_ids = ["father", "divine_essence", "son"]
  highlighted_edge_ids = ["father_one_essence", "son_one_essence", "father_distinct_from_son"]
  source_ids = ["st_i_29_4", "ccc_253_254", "ccc_255", "ccc_234_255"]
  focus_concept = "divine_essence"
  camera_z = 36.0

