graph_tour_steps[jewish_dialogue_creator]
  tour_id = "jewish_dialogue"
  title = "Creator and creatures"
  question = "How does creation differ from a division of God?"
  narrative = "God causes the being of creatures. Created being depends on God; the account of creation does not treat creatures as fragments of the divine essence."
  qualification = "The graph presents Aquinas's causal account for examination and dialogue."
  concept_ids = ["god", "created_being", "efficient_cause"]
  edge_ids = ["god_creates_all", "god_efficient_cause_role"]
  highlighted_concept_ids = ["god", "created_being", "efficient_cause"]
