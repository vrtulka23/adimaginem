# Cited editorial scenes; positions are display coordinates, not theological distances.

graph_tour_steps[jewish_dialogue_one]
  tour_id = "jewish_dialogue"
  title = "One, simple God"
  question = "What does Catholic theology affirm about divine unity?"
  narrative = "Aquinas argues that God is one and without composition. Catholic Trinitarian language is read within this confession of the one God."
  qualification = "The separate principle nodes explain aspects of one confession; they are not divine parts."
  concept_ids = ["god", "divine_unity", "divine_simplicity"]
  edge_ids = ["god_one", "god_simple"]
  highlighted_concept_ids = ["god", "divine_unity", "divine_simplicity"]
  highlighted_edge_ids = ["god_one", "god_simple"]
  source_ids = ["na_2_4", "st_i_11_3", "st_i_3_7"]
  focus_concept = "god"
  camera_z = 36

