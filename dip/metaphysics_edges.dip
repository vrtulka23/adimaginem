# Intrinsic principles, categories, capacities, and causal roles are distinguished.
ontology
  edges[matter_potential_to_form]
    subject str = "matter"
    relation str = "is_in_potency_to"
    object str = "form"
    source_id str = "dpn_8"
      ?descr "Matter is understood as in potency to form in natural generation."
      ?rationale "De principiis naturae section 8 explains matter through its capacity to receive form in generation."
    included_in_model bool = true

  edges[form_actualizes_matter]
    subject str = "form"
    relation str = "actualizes"
    object str = "matter"
    source_id str = "dpn_8"
      ?descr "Form makes what was in potency be in act."
      ?rationale "De principiis naturae section 8 treats form as that by which what is potential becomes actual."
    included_in_model bool = true
    causal_mode = "formal"

  edges[privation_in_becoming]
    subject str = "privation"
    relation str = "principle_of_becoming"
    object str = "natural_generation"
    source_id str = "dpn_12"
      ?descr "Privation is a principle of becoming, not of the completed thing's being."
      ?rationale "De principiis naturae section 12 distinguishes privation as a principle of becoming from the principles of the completed thing."
    included_in_model bool = true

  edges[potency_to_act]
    subject str = "potentiality"
    relation str = "is_realized_in"
    object str = "actuality"
    source_id str = "dpn_1"
      ?descr "The cited text distinguishes what can be from what already is in act."
      ?rationale "De principiis naturae section 1 contrasts being in potency with being in act; this edge summarizes that distinction."
    evidence_kind = "interpretive_inference"
    included_in_model bool = true
    conditions = "Here potentiality is considered as receptivity to act, not active power as though it were deficient in the same sense."
    condition_source_id = "st_i_25_1"

