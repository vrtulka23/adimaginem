# God alone creates; classification and conditions use separate predicates.
ontology
  edges[god_same_as_trinity]
    subject str = "god"
    relation str = "denotes_same_god_as"
    object str = "trinity"
    source_id str = "ccc_290_292"
      ?rationale "Catechism §§290-292 teaches that creation is the common work of the one Holy Trinity; this edge resolves two labels for that one God."
    evidence_kind = "editorial_classification"
    included_in_model bool = true

  edges[god_creates_all]
