# Cited angelic influence records; all concepts and edges default to draft.
ontology
  edges[good_angel_can_illuminate]
    subject = "blessed_angel"
    relation = "can_perform"
    object = "angelic_illumination"
    source_id str = "st_i_111_1"
      ?rationale "Good angels assist human understanding."
    recipient_scope = "human_person"
    affected_aspect = "act"
    causal_mode = "noncausal"
    evidence_kind = "textual_paraphrase"
    included_in_model = true
    conditions = "A capacity and ministry under providence; not a claim that every cognition has a separately identified angelic cause."
    condition_source_id = "st_i_111_1"

