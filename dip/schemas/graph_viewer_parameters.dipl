?descr "Default icon sizing and collision spacing for the standalone 3D ontology viewer"
icon_size float = 2.0
  ?descr "Relative diameter of each 3D node icon; the annealing collision radius scales from this value."
  ?recommended_range "0.85 to 10.0 viewer units"
icon_size_min float = 0.85
  ?descr "Smallest icon size exposed by the graph viewer control."
icon_size_max float = 10.0
  ?descr "Largest icon size exposed by the graph viewer control."
icon_size_step float = 0.1
  ?descr "Increment used by the graph viewer icon size control."
icon_gap float = 0.65
  ?descr "Extra collision spacing around each icon during layout annealing."
icon_hit_padding float = 0.08
  ?descr "Small extra margin around the icon outline for pointer hover and selection, in viewer units."

dimmed_icon_opacity float = 0.12
  ?descr "Opacity of icons outside the groups highlighted through the legend."

focus_emission float = 0.3
  ?descr "Additional illumination of selected icons and groups highlighted through the legend."

focused_relation_opacity float = 0.7
  ?descr "Opacity of relations incident to a highlighted group."

dimmed_relation_opacity float = 0.025
  ?descr "Opacity of relations unrelated to a highlighted group."

arrow_size_ratio float = 0.5
  ?descr "Arrowhead length relative to icon size; layout spacing reserves room for it."

arrow_position float = 0.5
  ?descr "Position along each directed relation: 0 is its subject, 1 its object, 0.5 its midpoint."

arrow_opacity float = 0.85
  ?descr "Default arrowhead opacity, brighter than its connecting line."

relation_opacity float = 0.34
  ?descr "Default relation line opacity when no concept or legend group is focused."

relation_width float = 0.07
  ?descr "Ordinary relation line width in viewer units."

highlighted_relation_width float = 0.4
  ?descr "Line width for a selected path or a relation incident to the selected concept."

parallel_curve_step float = 0.5
  ?descr "Curvature spacing between relations sharing the same pair of concepts, including reverse relations."

link_spacing float = 1.6
  ?descr "Multiplier for preferred link distances, including icon and arrow clearance."

charge_strength float = -8.0
  ?descr "Repulsion strength at the default icon size; scales quadratically with icon size."

fit_padding float = 45.0
  ?descr "Screen margin in pixels when fitting the graph to the viewport."

selection_ring_color str = "#9fffe0"
  ?descr "Color of the selected concept's glowing ring, as a six-digit hex color."

selection_ring_radius float = 0.84
  ?descr "Selection ring radius relative to icon size."

selection_ring_width float = 0.04
  ?descr "Selection ring stroke width relative to icon size; the glow fades around this stroke."

selection_ring_opacity float = 0.95
  ?descr "Peak opacity of the selection ring."

selection_ring_dashes int = 8
  ?descr "Number of rotating bright segments around the selection ring."

selection_ring_speed float = 0.55
  ?descr "Rotation in radians per second; zero gives a static ring. Browser reduced-motion preferences also stop rotation."

selection_repulsion_enabled bool = true
  ?descr "Temporarily open space around a selected concept and restore the layout on deselection."

selection_repulsion_radius float = 7.0
  ?descr "Local expansion radius as a multiple of the selected icon size, including its individual scale."

selection_repulsion_strength float = 0.35
  ?descr "Maximum outward displacement as a fraction of the radius, fading quadratically to zero at its boundary."

selection_return_strength float = 0.3
  ?descr "Spring strength for smoothly opening and restoring the local layout."

label_height float = 0.45
  ?descr "Concept label height relative to icon size; width fits the text without squeezing its letters."

label_min_text_pixels float = 14.0
  ?descr "Minimum label font size in CSS pixels, maintained when zooming out."

label_gap float = 0.1
  ?descr "Space between the selection ring glow and the label, relative to icon size."

god_icon_scale float = 1.8
  ?descr "Size multiplier reserved for the God emblem; included in collision, link, ring, and label spacing."

god_icon_color str = "#ffd66b"
  ?descr "Gold color reserved for the bespoke God emblem."

god_icon_core_color str = "#fff7de"
  ?descr "Ivory color of the central faceted light in the God emblem."

god_icon_emission float = 0.65
  ?descr "Base illumination of the God emblem, with selection emphasis added to it."

god_icon_glow_opacity float = 0.38
  ?descr "Opacity of decorative radiance; it does not capture pointer events."

influence_summary_depth int = 3
  ?descr "Maximum number of recorded steps explored for the influence overview; limits are gathered separately from the selected statements."

study_focus_concept str = "trinity"
  ?descr "Concept whose existing color-category group supplies the study focus; its cited note introduces the topic."

study_focus_enabled bool = false
  ?descr "Whether the viewer initially restricts the graph to the study focus group."

# Force layout controls. These are editorial display choices.

structural_link_kinds str[1:] = ["identity", "classification", "composition"]
  ?descr "Relation kinds sharing the structural attraction and distance settings; is_kind_of always uses its specific settings."

link_strength_kind_of float = 0.5
  ?descr "Attraction for is_kind_of edges. Viewer layout only, not philosophical or causal strength."
  !condition ({.} >= 0 && {.} <= 1)

link_strength_structural float = 0.3
  ?descr "Attraction for structural_link_kinds, except is_kind_of. Viewer layout only."
  !condition ({.} >= 0 && {.} <= 1)

link_strength_default float = 0.2
  ?descr "Attraction for all remaining edges, including influence relations. Viewer layout only."
  !condition ({.} >= 0 && {.} <= 1)

link_distance_kind_of float = 2.7
  ?descr "Preferred is_kind_of distance before icon clearance and the link_spacing multiplier, in viewer units."
  !condition ({.} > 0)

link_distance_structural float = 3.2
  ?descr "Preferred structural-kind distance before icon clearance and link_spacing, in viewer units."
  !condition ({.} > 0)

link_distance_default float = 4.1
  ?descr "Preferred distance for other edges before icon clearance and link_spacing, in viewer units."
  !condition ({.} > 0)

link_arrow_clearance_ratio float = 2.0
  ?descr "Total arrow clearance added to each link, as a multiple of the rendered arrow length."
  !condition ({.} >= 0)

charge_icon_scale_exponent float = 2.0
  ?descr "Exponent applied to current/default icon size when scaling charge_strength; zero keeps charge independent of icon size."
  !condition ({.} >= 0)

collision_icon_radius_ratio float = 0.52
  ?descr "Collision radius as a fraction of the scaled icon diameter, before gap and arrow clearance."
  !condition ({.} > 0)

collision_arrow_clearance_ratio float = 0.5
  ?descr "Extra collision radius as a multiple of the rendered arrow length."
  !condition ({.} >= 0)

collision_strength float = 0.72
  ?descr "Strength of collision resolution per iteration."
  !condition ({.} >= 0 && {.} <= 1)

collision_iterations int = 2
  ?descr "Collision solver iterations per simulation tick."
  !condition ({.} >= 1)

alpha_decay float = 0.045
  ?descr "Fractional simulation cooling per tick; lower values let forces act longer."
  !condition ({.} > 0 && {.} < 1)

alpha_min float = 0.002
  ?descr "Cooling threshold at which the force simulation settles."
  !condition ({.} > 0 && {.} < 1)

velocity_decay float = 0.65
  ?descr "Fraction of velocity removed per tick; larger values damp motion more strongly."
  !condition ({.} >= 0 && {.} < 1)

cooldown_ms int = 9000
  ?descr "Maximum wall-clock duration of a settling run, in milliseconds."
  !condition ({.} > 0)

initial_radius float = 5.0
  ?descr "Radius of the deterministic initial spherical placement, in viewer units."
  !condition ({.} > 0)

initial_jitter float = 0.2
  ?descr "Width of the centered deterministic per-concept position perturbation, in viewer units; zero disables it."
  !condition ({.} >= 0)

# Guided-tour presentation defaults.
tour_icon_size float = 3.0
  ?descr "Icon size for authored tour coordinates; the previous exploration size is restored on exit."
  !condition ({.} > 0)

tour_transition_ms int = 800
  ?descr "Duration of tour camera transitions in milliseconds; reduced-motion preference makes them immediate."
  !condition ({.} >= 0)
