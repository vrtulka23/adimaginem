?descr "A cited directed relation between two ontological concepts"
subject str
relation str
  !options ["actualizes", "distinct_in_essence_from", "has_corporeal_dimension", "has_part", "has_power_genus", "has_substantial_form", "inheres_in_subject", "is_act_of", "is_in_potency_to", "is_kind_of", "is_passion_of", "is_realized_in", "natural_principle_of", "operates_through_organ", "principle_of_becoming", "has_formal_object", "follows_apprehension", "is_person_of", "has_one_divine_essence", "perfects", "is_sacrament_of_group", "confers_character", "instrumentally_causes_grace", "creates", "denotes_same_god_as", "is_fallen_condition_of", "lacks_corporeality", "is_pure_act"]
  !labels ["Actualizes", "Distinct in essence from", "Has corporeal dimension", "Has part", "Has power genus", "Has substantial form", "Inheres in subject", "Is an act of", "Is in potency to", "Is a kind of", "Is a passion of", "Is realized in", "Is a natural principle of", "Operates through a bodily organ", "Is a principle of becoming", "Has formal object", "Follows apprehension", "Is a person of", "Has one divine essence", "Perfects", "Is a sacrament in group", "Confers character", "Instrumentally causes grace", "Creates", "Denotes the same God as", "Is a fallen condition of", "Lacks corporeality", "Is pure act"]
object str
evidence_kind str = "textual_paraphrase"
  !options ["textual_paraphrase", "interpretive_inference", "editorial_classification"]
  !labels ["Textual paraphrase", "Interpretive inference", "Editorial classification"]
review_status str = "draft"
  !options ["draft", "reviewed", "contested"]
  !labels ["Draft", "Reviewed", "Contested"]
included_in_model bool
