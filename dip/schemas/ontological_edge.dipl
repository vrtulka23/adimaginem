?descr "A cited directed relation between two concepts in the human ontology"
subject str
relation str
  !options ["actualizes", "distinct_in_essence_from", "has_corporeal_dimension", "has_part", "has_power_genus", "has_substantial_form", "inheres_in_subject", "is_act_of", "is_in_potency_to", "is_kind_of", "is_passion_of", "is_realized_in", "natural_principle_of", "operates_through_organ", "principle_of_becoming"]
  !labels ["Actualizes", "Distinct in essence from", "Has corporeal dimension", "Has part", "Has power genus", "Has substantial form", "Inheres in subject", "Is an act of", "Is in potency to", "Is a kind of", "Is a passion of", "Is realized in", "Is a natural principle of", "Operates through a bodily organ", "Is a principle of becoming"]
object str
evidence_kind str = "textual_paraphrase"
  !options ["textual_paraphrase", "interpretive_inference", "editorial_classification"]
  !labels ["Textual paraphrase", "Interpretive inference", "Editorial classification"]
review_status str = "draft"
  !options ["draft", "reviewed", "contested"]
  !labels ["Draft", "Reviewed", "Contested"]
included_in_model bool
