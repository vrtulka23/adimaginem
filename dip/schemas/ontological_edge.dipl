# Qualifiers describe a cited claim; they are not executable transition rules.
recipient_scope str = "unspecified"
  !options ["unspecified", "human_person", "angel", "blessed_angel"]
  !labels ["Unspecified", "Human person", "Angel", "Blessed angel"]

affected_aspect str = "unspecified"
  !options ["unspecified", "soul", "faculty", "habit", "act", "body", "relationship", "community"]
  !labels ["Unspecified", "Soul", "Faculty", "Habit", "Act", "Body", "Relationship", "Community"]

causal_mode str = "unspecified"
  !options ["unspecified", "principal", "instrumental", "dispositive", "perfective", "final", "formal", "material", "noncausal"]
  !labels ["Unspecified", "Principal cause", "Instrumental cause", "Disposition", "Perfection", "Purpose", "Formal cause", "Material cause", "Noncausal relation"]

conditions str = none

condition_source_id str = none
