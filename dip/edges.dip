  edges[privation_in_becoming]
    subject str = "privation"
      !constant
    relation str = "principle_of_becoming"
      !constant
      ?descr "Privation is a principle of becoming, not of the completed thing's being."
    object str = "natural_generation"
      !constant
    source_id str = "dpn_12"
