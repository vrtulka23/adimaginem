  edges[matter_potential_to_form]
    subject str = "matter"
      !constant
    relation str = "is_in_potency_to"
      !constant
      ?descr "Matter is understood as in potency to form in natural generation."
    object str = "form"
      !constant
    source_id str = "dpn_8"
      !constant
    included_in_model bool = true
  edges[form_actualizes_matter]
    subject str = "form"
      !constant
    relation str = "actualizes"
