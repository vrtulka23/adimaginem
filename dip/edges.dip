# Cited relations. `included_in_model` selects a simulation view; it does not alter a claim.
ontology
  edges map : ontological_edge
  edges[person_has_body]
    subject str = "human_person"
    relation str = "has_corporeal_dimension"
    object str = "human_body"
    source_id str = "st_i_75_4"
      ?descr "The body belongs to the human being; the person is not the soul alone."
      ?rationale "ST I, q. 75, a. 4 argues that a human being is not the soul alone; corporeality belongs to the human composite."
    included_in_model bool = true

  edges[person_has_form]
    subject str = "human_person"
    relation str = "has_substantial_form"
    object str = "rational_soul"
    source_id str = "st_i_76_1"
      ?descr "The intellectual soul is the substantial form of the human body."
      ?rationale "ST I, q. 76, a. 1 identifies the intellectual soul as the form of the human body."
    included_in_model bool = true

  edges[soul_distinct_from_power]
    subject str = "rational_soul"
    relation str = "distinct_in_essence_from"
    object str = "soul_power"
    source_id str = "st_i_77_1"
      ?descr "A power of the soul is not identical with the soul's essence."
      ?rationale "ST I, q. 77, a. 1 distinguishes the soul's essence from its operative powers."
    included_in_model bool = true

  edges[soul_origin_of_powers]
    subject str = "rational_soul"
    relation str = "natural_principle_of"
    object str = "soul_power"
    source_id str = "st_i_77_6"
      ?descr "The powers proceed from the soul's essence as natural properties."
      ?rationale "ST I, q. 77, a. 6 derives powers from the soul's essence as natural properties."
    included_in_model bool = true

