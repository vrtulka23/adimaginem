# Formal distinctions for the eleven passions, not intensity or a causal rule.
ontology
  passion_profiles map : passion_profile
  passion_profiles[love_passion]
    concept_id = "love_passion"
    appetite_id = "concupiscible_appetite"
    object_aspect = "good"
    arduous = false
    phase = "initial_affinity"
    temporal_relation = "not_specified"
    object_description = "Good apprehended as suitable, whether absent or possessed."
    attainability = "not_specified"
    source_id str = "st_i_ii_26_1_2"
      ?rationale "The cited passage supports this editorial profile: Good apprehended as suitable, whether absent or possessed."

  passion_profiles[hatred_passion]
    concept_id = "hatred_passion"
    appetite_id = "concupiscible_appetite"
    object_aspect = "evil"
    arduous = false
    phase = "initial_affinity"
    temporal_relation = "not_specified"
    object_description = "Evil apprehended as unsuitable, whether absent or present."
    attainability = "not_specified"
    source_id str = "st_i_ii_29_1"
      ?rationale "The cited passage supports this editorial profile: Evil apprehended as unsuitable, whether absent or present."

  passion_profiles[desire_passion]
    concept_id = "desire_passion"
    appetite_id = "concupiscible_appetite"
    object_aspect = "good"
    arduous = false
    phase = "approach"
    temporal_relation = "not_yet_present"
    object_description = "Apprehended good not yet possessed."
    attainability = "not_specified"
    source_id str = "st_i_ii_23_4"
      ?rationale "The cited passage supports this editorial profile: Apprehended good not yet possessed."

  passion_profiles[aversion_passion]
    concept_id = "aversion_passion"
    appetite_id = "concupiscible_appetite"
    object_aspect = "evil"
    arduous = false
    phase = "withdrawal"
    temporal_relation = "not_yet_present"
    object_description = "Apprehended evil not yet present."
    attainability = "not_specified"
    source_id str = "st_i_ii_23_4"
      ?rationale "The cited passage supports this editorial profile: Apprehended evil not yet present."

  passion_profiles[joy_passion]
    concept_id = "joy_passion"
    appetite_id = "concupiscible_appetite"
    object_aspect = "good"
    arduous = false
    phase = "present_response"
    temporal_relation = "present"
    object_description = "Apprehended suitable good possessed or attained."
    attainability = "not_specified"
    source_id str = "st_i_ii_31_1_3"
      ?rationale "The cited passage supports this editorial profile: Apprehended suitable good possessed or attained."

  passion_profiles[sorrow_passion]
    concept_id = "sorrow_passion"
    appetite_id = "concupiscible_appetite"
    object_aspect = "evil"
    arduous = false
    phase = "present_response"
    temporal_relation = "present"
    object_description = "Apprehended evil already encountered."
    attainability = "not_specified"
    source_id str = "st_i_ii_23_4"
      ?rationale "The cited passage supports this editorial profile: Apprehended evil already encountered."

  passion_profiles[hope_passion]
    concept_id = "hope_passion"
    appetite_id = "irascible_appetite"
    object_aspect = "good"
    arduous = true
    phase = "approach"
    temporal_relation = "not_yet_present"
    object_description = "Future arduous good apprehended as possible to obtain."
    attainability = "possible"
    source_id str = "st_i_ii_40_1"
      ?rationale "The cited passage supports this editorial profile: Future arduous good apprehended as possible to obtain."

  passion_profiles[despair_passion]
    concept_id = "despair_passion"
    appetite_id = "irascible_appetite"
    object_aspect = "good"
    arduous = true
    phase = "withdrawal"
    temporal_relation = "not_yet_present"
    object_description = "Future arduous good apprehended as impossible to obtain."
    attainability = "impossible"
    source_id str = "st_i_ii_40_4"
      ?rationale "The cited passage supports this editorial profile: Future arduous good apprehended as impossible to obtain."

  passion_profiles[fear_passion]
    concept_id = "fear_passion"
    appetite_id = "irascible_appetite"
    object_aspect = "evil"
    arduous = true
    phase = "withdrawal"
    temporal_relation = "not_yet_present"
    object_description = "Future threatening evil apprehended as difficult to resist or avoid."
    attainability = "not_specified"
    source_id str = "st_i_ii_42_3"
      ?rationale "The cited passage supports this editorial profile: Future threatening evil apprehended as difficult to resist or avoid."

  passion_profiles[daring_passion]
    concept_id = "daring_passion"
    appetite_id = "irascible_appetite"
    object_aspect = "evil"
    arduous = true
    phase = "approach"
    temporal_relation = "not_yet_present"
    object_description = "Threatening evil confronted in hope of victory over it."
