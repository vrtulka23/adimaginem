      ?rationale "The cited passage supports this editorial profile: Threatening evil confronted in hope of victory over it."

  passion_profiles[anger_passion]
    concept_id = "anger_passion"
    appetite_id = "irascible_appetite"
    object_aspect = "good_and_evil"
    arduous = true
    phase = "attack"
    temporal_relation = "experienced_harm_and_future_redress"
    object_description = "Experienced injury and its hurtful agent as evil; desired vengeance as an apparent just good still attainable."
    attainability = "possible"
    source_id str = "st_i_ii_46_1_2"
      ?rationale "The cited passage supports this editorial profile: Experienced injury and its hurtful agent as evil; desired vengeance as an apparent just good still attainable."

