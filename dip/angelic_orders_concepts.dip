# Cited angelic orders records; all concepts and edges default to draft.
ontology
  concepts[angelic_order]
    label = "Angelic order"
    latin_name = "ordo angelicus"
    domain = "theology"
    category = "angelic_order"
    note = "A rank of heavenly spirits according to their perfections and offices; not a separate bodily species."
    source_id = "st_i_108_1_4"

  concepts[angelic_hierarchy]
    label = "Angelic hierarchy"
    latin_name = "hierarchia angelica"
    domain = "theology"
    category = "angelic_hierarchy"
    note = "An ordered grouping of angelic orders under divine government."
    source_id = "st_i_108_1_4"

  concepts[first_angelic_hierarchy]
    label = "First angelic hierarchy"
    latin_name = "hierarchia prima"
    domain = "theology"
    category = "angelic_hierarchy"
    note = "Contemplation of the divine reasons in God. Dionysian arrangement expounded by Aquinas."
    source_id = "st_i_108_6"

  concepts[second_angelic_hierarchy]
    label = "Second angelic hierarchy"
    latin_name = "hierarchia secunda"
    domain = "theology"
    category = "angelic_hierarchy"
    note = "Universal disposition of angelic work. Dionysian arrangement expounded by Aquinas."
    source_id = "st_i_108_6"

  concepts[third_angelic_hierarchy]
    label = "Third angelic hierarchy"
    latin_name = "hierarchia tertia"
    domain = "theology"
    category = "angelic_hierarchy"
    note = "Application of divine ordering to particular effects. Dionysian arrangement expounded by Aquinas."
    source_id = "st_i_108_6"

  concepts[seraphim]
    label = "Seraphim"
    latin_name = "Seraphim"
    domain = "theology"
    category = "angelic_order"
    note = "Named angelic order; perfections are shared by participation and are not exclusive capacities."
    source_id = "st_i_108_5"

  concepts[seraphic_ardor]
