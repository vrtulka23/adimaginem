# Cited Trinitarian distinctions; no temporal simulation or causal composition is licensed.
ontology
  edges[word_names_son]
    subject = "eternal_word"
    relation = "is_personal_name_of"
    object = "son"
    source_id str = "st_i_34_2"
      ?rationale "ST I, q. 34, a. 2 identifies Word as the proper name of the Son; ad 1 excludes a created effect or accident."
    causal_mode = "noncausal"
    included_in_model = true

  edges[love_names_spirit]
    subject = "subsistent_love"
    relation = "is_personal_name_of"
    object = "holy_spirit"
    source_id str = "st_i_37_1"
      ?rationale "ST I, q. 37, a. 1 uses Love personally for the Holy Spirit."
    causal_mode = "noncausal"
    included_in_model = true
    conditions = "Love here signifies the person proceeding, not the essential act common to all three."
    condition_source_id = "st_i_37_1"

