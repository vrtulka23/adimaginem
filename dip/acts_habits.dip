  concepts[sensing]
    latin_name = "sentire"
    label = "Sensing"
    domain = "anthropology"
    category = "act"
    note = "A sensitive operation, distinguished here from a sensitive power."
    source_id = "st_i_78_1"

  concepts[imagining]
    latin_name = "imaginari"
    label = "Imagining"
    domain = "anthropology"
    category = "act"
    note = "Operation of imagination concerning sensible forms."
    source_id = "st_i_78_4"

  concepts[understanding]
    latin_name = "intelligere"
    label = "Understanding"
    domain = "anthropology"
    category = "act"
    note = "Actual intellectual operation; in embodied life it turns to phantasms."
    source_id = "st_i_84_7"

  concepts[willing]
    latin_name = "velle"
    label = "Willing"
    domain = "anthropology"
    category = "act"
    note = "Act of will concerning good as apprehended."
    source_id = "st_i_ii_8_1"

  concepts[counsel]
    latin_name = "consilium"
    label = "Counsel or deliberation"
    domain = "anthropology"
    category = "act"
    note = "Reason's inquiry about means to an end, ordered to choice."
    source_id = "st_i_ii_14_1"

  concepts[habit]
    latin_name = "habitus"
    label = "Habit"
    domain = "anthropology"
    category = "habit"
    note = "A relatively stable dispositional quality, distinct from a momentary operation."
    source_id = "st_i_ii_49_1"

  concepts[phantasm]
    latin_name = "phantasma"
    label = "Phantasm"
    domain = "anthropology"
    category = "formal_object"
    note = "An imaginative likeness of a particular sensible thing, used by the embodied intellect in understanding."
    source_id = "st_i_84_7"

  concepts[intelligible_species]
    latin_name = "species intelligibilis"
    label = "Intelligible species"
    domain = "anthropology"
    category = "formal_object"
    note = "The intelligible form by which the possible intellect understands; abstracted from phantasms in human knowing."
    source_id = "st_i_85_1"

  concepts[practical_intellect]
    latin_name = "intellectus practicus"
    label = "Practical intellect"
    domain = "anthropology"
    category = "power"
    note = "Intellect considered as ordering action; distinguished from speculative intellect by its end."
    source_id = "st_i_79_11"

  edges[sensing_of_sensitive_power]
    subject str = "sensing"
    relation str = "is_act_of"
    object str = "sensitive_power"
    source_id str = "st_i_78_1"
      ?rationale "ST I, q. 78, a. 1 distinguishes sensitive operations from their underlying genus of powers."
    included_in_model bool = true

  edges[imagining_of_imagination]
    subject str = "imagining"
    relation str = "is_act_of"
    object str = "imagination"
    source_id str = "st_i_78_4"
      ?rationale "ST I, q. 78, a. 4 assigns conservation of sensible forms to the imaginative power."
    included_in_model bool = true

  edges[understanding_of_intellect]
    subject str = "understanding"
    relation str = "is_act_of"
    object str = "intellectual_power"
    source_id str = "st_i_84_7"
      ?rationale "ST I, q. 84, a. 7 treats actual understanding as an operation of the intellect that turns to phantasms in embodied life."
    included_in_model bool = true

  edges[willing_of_will]
    subject str = "willing"
    relation str = "is_act_of"
    object str = "will"
    source_id str = "st_i_ii_8_1"
      ?rationale "ST I-II, q. 8, a. 1 identifies willing as the will's act toward good as apprehended."
    included_in_model bool = true

  edges[counsel_of_intellect]
    subject str = "counsel"
    relation str = "is_act_of"
    object str = "intellectual_power"
    source_id str = "st_i_ii_14_1"
      ?rationale "ST I-II, q. 14, a. 1 treats counsel as rational inquiry, while acknowledging the will's involvement."
    included_in_model bool = true

  edges[virtue_as_habit]
    subject str = "virtue"
    relation str = "is_kind_of"
    object str = "habit"
    source_id str = "st_i_ii_55_1"
      ?rationale "ST I-II, q. 55, a. 1 argues that human virtue is a habit rather than a power or a single act."
    included_in_model bool = true

  edges[practical_intellect_is_intellectual]
    subject str = "practical_intellect"
    relation str = "is_kind_of"
    object str = "intellectual_power"
    source_id str = "st_i_79_11"
      ?rationale "ST I, q. 79, a. 11 distinguishes practical and speculative intellect by their ends, as modes of intellect."
    included_in_model bool = true

  edges[agent_intellect_renders_phantasm_intelligible]
    subject str = "agent_intellect"
    relation str = "renders_intelligible"
    object str = "phantasm"
    source_id str = "st_i_79_3"
      ?rationale "ST I, q. 79, a. 3 assigns the agent intellect the work of making phantasms actually intelligible."
    included_in_model bool = true

  edges[intelligible_species_abstracted_from_phantasm]
    subject str = "intelligible_species"
    relation str = "is_abstracted_from"
    object str = "phantasm"
    source_id str = "st_i_85_1"
      ?rationale "ST I, q. 85, a. 1 teaches that material things are understood through intelligible species abstracted from phantasms."
    included_in_model bool = true

  edges[possible_intellect_receives_species]
    subject str = "possible_intellect"
    relation str = "receives"
    object str = "intelligible_species"
    source_id str = "st_i_85_1"
      ?rationale "ST I, q. 85, a. 1 distinguishes the possible intellect's reception of intelligible species from the agent intellect's abstraction."
    included_in_model bool = true

  edges[understanding_turns_to_phantasm]
    subject str = "understanding"
    relation str = "turns_to"
    object str = "phantasm"
    source_id str = "st_i_84_7"
      ?rationale "ST I, q. 84, a. 7 holds that in embodied life the intellect understands actually by turning to phantasms."
    included_in_model bool = true

  edges[practical_intellect_moves_will_as_to_object]
    subject str = "practical_intellect"
    relation str = "moves_as_to_object"
    object str = "will"
    source_id str = "st_i_ii_9_1"
      ?rationale "ST I-II, q. 9, a. 1 says intellect moves the will by presenting and determining its object, the apprehended good."
    included_in_model bool = true

  edges[will_moves_practical_intellect_as_to_exercise]
    subject str = "will"
    relation str = "moves_as_to_exercise"
    object str = "practical_intellect"
    source_id str = "st_i_ii_9_1"
      ?rationale "ST I-II, q. 9, a. 1 says will moves intellect regarding the exercise or use of its act, while intellect specifies the act by its object."
    included_in_model bool = true

  edges[counsel_precedes_choice]
    subject str = "counsel"
    relation str = "precedes_in_practical_order"
    object str = "choice"
    source_id str = "st_i_ii_14_1"
      ?rationale "ST I-II, q. 14, a. 1 treats counsel as inquiry about means ordered toward choice."
    included_in_model bool = true

  edges[phantasm_retained_by_imagination]
    subject str = "phantasm"
    relation str = "is_retained_by"
    object str = "imagination"
    source_id str = "st_i_78_4"
      ?rationale "ST I, q. 78, a. 4 assigns the imagination retention of sensible forms when the sensed object is absent."
    included_in_model bool = true
