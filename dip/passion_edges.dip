    condition_source_id = "st_i_ii_46_1_2"

  edges[hope_can_give_rise_to_anger]
    subject = "hope_passion"
    relation = "can_give_rise_to"
    object = "anger_passion"
    source_id str = "st_i_ii_46_1_2"
      ?rationale "Hope of vengeance is among the antecedents of anger."
