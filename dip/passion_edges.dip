  edges[sorrow_can_give_rise_to_anger]
    subject = "sorrow_passion"
    relation = "can_give_rise_to"
    object = "anger_passion"
    source_id str = "st_i_ii_46_1_2"
      ?rationale "Anger arises with pain from injury and desire and hope of vengeance."
